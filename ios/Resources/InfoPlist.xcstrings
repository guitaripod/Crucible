    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible forbinder sig til din Plex Media Server på dit hjemmenetværk for at gennemse og afspille dit bibliotek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible verbindet sich in deinem Heimnetzwerk mit deinem Plex Media Server, um deine Mediathek zu durchsuchen und abzuspielen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Crucible connects to your Plex Media Server on your home network to browse and play your library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible se conecta a tu servidor de Plex Media Server en tu red doméstica para explorar y reproducir tu biblioteca."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible yhdistää kotiverkossasi Plex Media Serveriin, jotta voit selata ja toistaa kirjastoasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible se connecte à votre serveur Plex Media Server sur votre réseau domestique pour parcourir et lire votre bibliothèque."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible tengist Plex-þjóninum þínum á heimanetinu þínu til að skoða safnið þitt og spila efni úr því."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible si connette al tuo Plex Media Server nella rete domestica per sfogliare e riprodurre la tua libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible は、ホームネットワーク上の Plex Media Server に接続して、ライブラリを閲覧および再生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible은 홈 네트워크의 Plex Media Server에 연결해 보관함을 둘러보고 재생해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible kobler seg til Plex Media Server på hjemmenettverket ditt for å bla gjennom og spille av biblioteket ditt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible łączy się z Twoim serwerem Plex Media Server w sieci domowej, aby przeglądać i odtwarzać Twoją bibliotekę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Crucible se conecta ao seu Plex Media Server na sua rede doméstica para navegar e reproduzir sua biblioteca."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible ansluter till din Plex Media Server på ditt hemnätverk för att bläddra i och spela upp ditt bibliotek."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible 会在你的家庭网络中连接 Plex 媒体服务器，以浏览和播放你的资料库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible 會連線到您家中網路上的 Plex 媒體伺服器，以瀏覽及播放您的媒體庫。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible gemmer de kort, du laver over det, du har set, i dit fotobibliotek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible speichert die Karten, die du von dem erstellst, was du gesehen hast, in deiner Fotomediathek."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Crucible saves the cards you make of what you watched to your photo library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible guarda en tu biblioteca de fotos las tarjetas que creas con lo que has visto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible tallentaa tekemäsi kortit katsomistasi elokuvista ja sarjoista kuvakirjastoosi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible enregistre dans votre photothèque les cartes que vous créez à partir de ce que vous avez regardé."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible vistar spjöldin sem þú býrð til um það sem þú hefur séð í myndasafnið þitt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible salva nella tua libreria foto le schede che crei su ciò che hai visto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible は、視聴した作品で作成したカードを写真ライブラリに保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible은 시청한 작품으로 만든 카드를 사진 보관함에 저장해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible lagrer kortene du lager av det du har sett, i bildebiblioteket ditt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible zapisuje w Twojej bibliotece zdjęć karty, które tworzysz z tego, co obejrzałeś."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Crucible salva na sua biblioteca de fotos os cartões que você cria com o que assistiu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible sparar de kort du skapar av det du har sett till ditt fotobibliotek."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible 会将你为观看过的作品制作的卡片保存到照片图库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible 會把您製作的觀影卡片儲存到您的照片圖庫。"
          }
        }
      }
