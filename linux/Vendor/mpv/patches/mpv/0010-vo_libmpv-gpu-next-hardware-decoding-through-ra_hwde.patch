 // Forward declarations
 struct mp_log;
@@ -59,6 +63,15 @@ struct pl_video_osd_state {
  * and OSD elements using libplacebo. It includes the frame queue, current
  * video parameters, OSD resources, and color adjustment state.
  */
+struct pl_video_hwdec {
+    struct ra_ctx *ra_ctx;
+    struct ra_hwdec_ctx ctx;
+    struct ra_hwdec_mapper *mapper;
+    struct mp_image *owner;
+    pl_tex tex[4];
+    bool acquired;
+};
+
 struct pl_video {
     struct mp_log *log;
     struct ra_next *ra;    // The libplacebo rendering abstraction
@@ -85,6 +98,8 @@ struct pl_video {
     // Color adjustment state
     struct mp_csp_equalizer_state *video_eq; // Manages brightness, contrast, hue, etc.
 
+    struct pl_video_hwdec hw;
+
     // Scaler configs storage (for map_scaler)
     struct pl_filter_config scalers[SCALER_COUNT];
 
@@ -98,8 +113,10 @@ struct pl_video {
  */
 struct frame_priv {
     struct pl_video *p; // A pointer back to the main pl_video engine struct.
+    struct ra_hwdec *hwdec;
 };
 
+
 /**
  * @brief Callback to map an mp_image to a pl_frame for rendering.
  *
@@ -111,6 +128,103 @@ struct frame_priv {
  * @param frame The destination `pl_frame` to be populated with GPU texture info.
  * @return True on success, false on failure.
  */
+static void hwdec_unmap(struct pl_video *p)
+{
+    struct pl_video_hwdec *hw = &p->hw;
+    hw->acquired = false;
+    memset(hw->tex, 0, sizeof(hw->tex));
+    if (hw->mapper)
+        ra_hwdec_mapper_unmap(hw->mapper);
+    hw->owner = NULL;
+}
+
+static bool hwdec_reconfig(struct pl_video *p, struct ra_hwdec *hwdec,
+                           const struct mp_image_params *par)
+{
+    struct pl_video_hwdec *hw = &p->hw;
+    if (hw->mapper) {
+        if (mp_image_params_static_equal(par, &hw->mapper->src_params)) {
+            hw->mapper->src_params.repr.dovi = par->repr.dovi;
+            hw->mapper->dst_params.repr.dovi = par->repr.dovi;
+            hw->mapper->src_params.color.hdr = par->color.hdr;
+            hw->mapper->dst_params.color.hdr = par->color.hdr;
+            return true;
+        }
+        hwdec_unmap(p);
+        ra_hwdec_mapper_free(&hw->mapper);
+    }
+    hw->mapper = ra_hwdec_mapper_create(hwdec, par);
+    if (!hw->mapper) {
+        mp_msg(p->log, MSGL_ERR, "Initializing texture for hardware decoding failed.\n");
+        return false;
+    }
+    return true;
+}
+
+static bool hwdec_acquire(pl_gpu gpu, struct pl_frame *frame)
+{
+    struct mp_image *mpi = frame->user_data;
+    struct frame_priv *fp = mpi->priv;
+    struct pl_video *p = fp->p;
+    struct pl_video_hwdec *hw = &p->hw;
+    if (!hwdec_reconfig(p, fp->hwdec, &mpi->params))
+        return false;
+    if (hw->owner != mpi) {
+        if (hw->acquired) {
+            mp_msg(p->log, MSGL_ERR, "Hardware frame is still in use.\n");
+            return false;
+        }
+        hwdec_unmap(p);
+        if (ra_hwdec_mapper_map(hw->mapper, mpi) < 0) {
+            mp_msg(p->log, MSGL_ERR, "Mapping hardware decoded surface failed.\n");
+            return false;
+        }
+        hw->owner = mpi;
+    }
+    if (ra_hwdec_mapper_begin_access(hw->mapper) < 0)
+        return false;
+    hw->acquired = true;
+    for (int n = 0; n < frame->num_planes; n++) {
+        if (!hw->tex[n])
+            hw->tex[n] = (pl_tex) hw->mapper->tex[n]->priv;
+        if (!hw->tex[n])
+            return false;
+        frame->planes[n].texture = hw->tex[n];
+    }
+    return true;
+}
+
+static void hwdec_release(pl_gpu gpu, struct pl_frame *frame)
+{
+    struct mp_image *mpi = frame->user_data;
+    struct frame_priv *fp = mpi->priv;
+    struct pl_video_hwdec *hw = &fp->p->hw;
+    if (!hw->acquired)
+        return;
+    ra_hwdec_mapper_end_access(hw->mapper);
+    hw->acquired = false;
+}
+
+static void hwdec_plane_mapping(struct pl_frame *frame, const struct mp_imgfmt_desc *desc)
+{
+    frame->num_planes = desc->num_planes;
+    for (int n = 0; n < frame->num_planes; n++) {
+        struct pl_plane *plane = &frame->planes[n];
+        int *map = plane->component_mapping;
+        for (int c = 0; c < mp_imgfmt_desc_get_num_comps(desc); c++) {
+            if (desc->comps[c].plane != n)
+                continue;
+            uint8_t offset = desc->comps[c].offset;
+            int index = plane->components++;
+            while (index > 0 && desc->comps[map[index - 1]].offset > offset) {
+                map[index] = map[index - 1];
+                index--;
+            }
+            map[index] = c;
+        }
+    }
+}
+
 static bool map_frame(pl_gpu gpu, pl_tex *tex, const struct pl_source_frame *src,
                       struct pl_frame *frame)
 {
@@ -118,6 +232,28 @@ static bool map_frame(pl_gpu gpu, pl_tex *tex, const struct pl_source_frame *src
     struct frame_priv *fp = mpi->priv;
     struct pl_video *p = fp->p;
 
+    fp->hwdec = p->hw.ra_ctx ? ra_hwdec_get(&p->hw.ctx, mpi->imgfmt) : NULL;
+    if (fp->hwdec) {
+        if (!hwdec_reconfig(p, fp->hwdec, &mpi->params)) {
+            talloc_free(mpi);
+            return false;
+        }
+        struct mp_image_params par = p->hw.mapper->dst_params;
+        mp_image_params_guess_csp(&par);
+        *frame = (struct pl_frame) {
+            .color = par.color,
+            .repr = par.repr,
+            .rotation = par.rotate / 90,
+            .user_data = mpi,
+            .acquire = hwdec_acquire,
+            .release = hwdec_release,
+        };
+        struct mp_imgfmt_desc desc = mp_imgfmt_get_desc(par.imgfmt);
+        hwdec_plane_mapping(frame, &desc);
+        pl_frame_set_chroma_location(frame, par.chroma_location);
+        return true;
+    }
+
     // Use the RA helper to upload the mp_image data to a new set of textures
     // and populate the pl_frame struct with the result.
     if (!ra_upload_mp_image(p->ra, frame, mpi)) {
@@ -150,8 +286,12 @@ static void unmap_frame(pl_gpu gpu, struct pl_frame *frame,
     struct frame_priv *fp = mpi->priv;
     struct pl_video *p = fp->p;
 
-    // Use the RA helper to destroy the GPU textures associated with the frame.
-    ra_cleanup_pl_frame(p->ra, frame);
+    if (fp->hwdec) {
+        if (p->hw.owner == mpi)
+            hwdec_unmap(p);
+    } else {
+        ra_cleanup_pl_frame(p->ra, frame);
+    }
     // Free the mp_image reference itself.
     talloc_free(mpi);
 }
@@ -200,11 +340,36 @@ struct pl_video *pl_video_init(struct mpv_global *global, struct mp_log *log, st
  * @brief Shuts down and destroys the rendering engine and its resources.
  * @param p_ptr A pointer to the pl_video engine pointer to be freed.
  */
+void pl_video_init_hwdecs(struct pl_video *p, struct mpv_global *global,
+                          struct mp_hwdec_devices *devs)
+{
+    struct ra *ra = ra_create_pl(p->ra->gpu, p->log);
+    if (!ra)
+        return;
+    p->hw.ra_ctx = talloc_zero(p, struct ra_ctx);
+    p->hw.ra_ctx->ra = ra;
+    p->hw.ra_ctx->global = global;
+    p->hw.ra_ctx->log = p->log;
+    p->hw.ctx = (struct ra_hwdec_ctx) {
+        .log = p->log,
+        .global = global,
+        .ra_ctx = p->hw.ra_ctx,
+    };
+    ra_hwdec_ctx_init(&p->hw.ctx, devs, NULL, true);
+}
+
 void pl_video_uninit(struct pl_video **p_ptr) {
     struct pl_video *p = *p_ptr;
     if (!p) return;
 
     ra_next_queue_destroy(&p->queue);
+    if (p->hw.ra_ctx) {
+        hwdec_unmap(p);
+        ra_hwdec_mapper_free(&p->hw.mapper);
+        ra_hwdec_ctx_uninit(&p->hw.ctx);
+        p->hw.ra_ctx->ra->fns->destroy(p->hw.ra_ctx->ra);
+        p->hw.ra_ctx->ra = NULL;
+    }
 
     // Clean up all allocated OSD GPU resources
     for (int i = 0; i < MP_ARRAY_SIZE(p->osd_state_storage.entries); i++) {
@@ -755,7 +920,7 @@ void pl_video_reset(struct pl_video *p) {
  * @return True if the format is likely supported, false otherwise.
  */
 bool pl_video_check_format(struct pl_video *p, int imgfmt) {
-    // For simplicity, we assume libplacebo can handle it.
-    // A more robust implementation might query libplacebo's capabilities.
+    if (IMGFMT_IS_HWACCEL(imgfmt))
+        return p->hw.ra_ctx && ra_hwdec_get(&p->hw.ctx, imgfmt);
     return true;
 }
