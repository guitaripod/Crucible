    "Forgets every web video you watched and where you stopped in it. Watch Later and the channels you follow stay." : {
      "comment" : "Confirmation before clearing web history",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glemmer alle webvideoer, du har set, og hvor du er stoppet i dem. Se senere og de kanaler, du følger, bliver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergisst jedes Web-Video, das du angesehen hast, und wo du darin aufgehört hast. Später ansehen und die Kanäle, denen du folgst, bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvida todos los vídeos web que has visto y dónde los dejaste. Ver más tarde y los canales que sigues se mantienen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unohtaa kaikki katsomasi verkkovideot ja kohdat, joihin niissä pysähdyit. Katso myöhemmin -lista ja seuraamasi kanavat säilyvät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oublie chaque vidéo du web que vous avez regardée et l’endroit où vous vous étiez arrêté. « À regarder plus tard » et les chaînes que vous suivez restent."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleymir öllum vefmyndskeiðum sem þú horfðir á og hvar þú hættir í þeim. Horfa síðar og rásirnar sem þú fylgist með haldast."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimentica ogni video dal web che hai guardato e il punto in cui ti sei fermato. Guarda più tardi e i canali che segui restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視聴したすべてのウェブ動画と、そこで再生を止めた位置を忘れます。「後で見る」とフォロー中のチャンネルは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시청한 모든 웹 동영상과 이어볼 위치를 지워요. 나중에 볼 동영상과 팔로우한 채널은 남아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glemmer alle webvideoer du har sett, og hvor du stoppet i dem. Se senere og kanalene du følger beholdes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa wszystkie oglądane filmy z sieci i miejsca, w których przerwano oglądanie. Lista Obejrzyj później i obserwowane kanały zostają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esquece todos os vídeos da web que você assistiu e onde parou em cada um. Assistir depois e os canais que você segue permanecem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glömmer alla webbvideor du har sett och var du slutade i dem. Se senare och kanalerna du följer finns kvar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将忘记你看过的所有网络视频以及每个视频的观看进度。“稍后观看”和你关注的频道会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會清除你看過的每部網路影片以及觀看進度。稍後觀看與你追蹤的頻道會保留。"
          }
        }
      }
