    "Optional. Adds your recommendations, your account’s lists, and members-only and age-restricted videos." : {
      "comment" : "Web video setting: what signing in with cookies adds",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valgfrit. Tilføjer dine anbefalinger, kontoens lister og videoer, der kun er for medlemmer, og aldersbegrænsede videoer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Ergänzt deine Empfehlungen, die Listen deines Kontos sowie Videos für Mitglieder und mit Altersbeschränkung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Añade tus recomendaciones, las listas de tu cuenta y los vídeos solo para miembros y con restricción de edad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valinnainen. Lisää suosituksesi, tilisi listat sekä vain jäsenille ja ikärajoitetut videot."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif. Ajoute vos recommandations, les listes de votre compte, ainsi que les vidéos réservées aux membres et soumises à une restriction d’âge."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valfrjálst. Bætir við ráðleggingum þínum, listum reikningsins og myndskeiðum fyrir meðlimi og aldurstakmarkað efni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facoltativo. Aggiunge i tuoi consigli, le liste del tuo account e i video riservati ai membri e con restrizioni di età."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意です。おすすめ、アカウントのリスト、メンバー限定動画と年齢制限のある動画が追加されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택 사항이에요. 추천 동영상, 계정의 목록, 멤버 전용 및 연령 제한 동영상을 함께 불러와요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valgfritt. Legger til anbefalingene dine, kontoens lister, og videoer for medlemmer og aldersbegrensede videoer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcjonalnie. Dodaje Twoje rekomendacje, listy konta oraz filmy tylko dla członków i z ograniczeniem wiekowym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Adiciona suas recomendações, as listas da sua conta e os vídeos exclusivos para membros e com restrição de idade."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valfritt. Lägger till dina rekommendationer, kontots listor och videor för medlemmar och åldersbegränsade videor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可选。将加入你的推荐、账户列表，以及仅限会员和年龄限制的视频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選用。會加入你的推薦、帳號的清單，以及僅限會員與年齡限制的影片。"
          }
        }
      }
    },
    "Paste the address of a video, a playlist or a channel. Anything yt-dlp can read plays." : {
      "comment" : "Explains what the Open Link panel accepts",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indsæt adressen på en video, en playliste eller en kanal. Alt, yt-dlp kan læse, afspilles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge die Adresse eines Videos, einer Playlist oder eines Kanals ein. Alles, was yt-dlp lesen kann, wird abgespielt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pega la dirección de un vídeo, una lista de reproducción o un canal. Se reproduce todo lo que yt-dlp pueda leer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liitä videon, soittolistan tai kanavan osoite. Kaikki, minkä yt-dlp osaa lukea, toistuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collez l’adresse d’une vidéo, d’une liste de lecture ou d’une chaîne. Tout ce que yt-dlp peut lire est lu."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Límdu inn slóð myndskeiðs, spilunarlista eða rásar. Allt sem yt-dlp getur lesið spilast."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incolla l’indirizzo di un video, di una playlist o di un canale. Riproduce tutto ciò che yt-dlp può leggere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動画、プレイリスト、チャンネルのアドレスを貼り付けてください。yt-dlp が読み取れるものはすべて再生できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동영상, 재생목록, 채널의 주소를 붙여 넣으세요. yt-dlp가 읽을 수 있는 주소는 모두 재생돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lim inn adressen til en video, en spilleliste eller en kanal. Alt yt-dlp kan lese, spilles av."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wklej adres filmu, playlisty lub kanału. Odtworzone zostanie wszystko, co potrafi odczytać yt-dlp."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cole o endereço de um vídeo, de uma playlist ou de um canal. Tudo o que o yt-dlp consegue ler é reproduzido."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klistra in adressen till en video, en spellista eller en kanal. Allt som yt-dlp kan läsa spelas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粘贴视频、播放列表或频道的地址。yt-dlp 能读取的内容都可以播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貼上影片、播放清單或頻道的網址。yt-dlp 能讀取的內容都能播放。"
          }
        }
      }
    },
