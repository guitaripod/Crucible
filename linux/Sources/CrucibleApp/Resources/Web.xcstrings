        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade ein Video über sein Menü herunter, um es ohne Verbindung anzusehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga un vídeo desde su menú para verlo sin conexión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lataa video sen valikosta, niin voit katsoa sen ilman yhteyttä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téléchargez une vidéo depuis son menu pour la regarder sans connexion."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæktu myndband úr valmyndinni til að horfa á það án nettengingar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica un video dal suo menu per guardarlo senza connessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューから動画をダウンロードすると、接続なしで視聴できます。"
          }
        },
        "ko" : {
