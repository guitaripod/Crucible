    "Download a video from its menu to watch it without a connection." : {
      "comment" : "Empty web downloads list",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hent en video fra menuen for at se den uden forbindelse."
