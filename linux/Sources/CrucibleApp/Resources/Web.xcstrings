    "Automatic picks AV1, then VP9, then H.264. Choose H.264 if high resolutions stutter." : {
      "comment" : "Web video setting: what the codec choice does",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisk vælger AV1, derefter VP9, derefter H.264. Vælg H.264, hvis høje opløsninger hakker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch wählt AV1, dann VP9, dann H.264. Wähle H.264, wenn hohe Auflösungen ruckeln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automático elige AV1, luego VP9 y después H.264. Elige H.264 si las resoluciones altas se entrecortan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaattinen valitsee ensin AV1:n, sitten VP9:n ja sen jälkeen H.264:n. Valitse H.264, jos suuret resoluutiot nykivät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatique choisit AV1, puis VP9, puis H.264. Choisissez H.264 si les hautes résolutions saccadent."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjálfvirkt velur AV1, síðan VP9, síðan H.264. Veldu H.264 ef háar upplausnir hökta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatico sceglie AV1, poi VP9, poi H.264. Scegli H.264 se le risoluzioni alte scattano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動」は AV1、次に VP9、続いて H.264 を選びます。高解像度でカクつく場合は H.264 を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동은 AV1, VP9, H.264 순으로 고릅니다. 고해상도에서 끊기면 H.264를 고르세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisk velger AV1, deretter VP9, deretter H.264. Velg H.264 hvis høye oppløsninger hakker."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryb automatyczny wybiera AV1, potem VP9, a na końcu H.264. Wybierz H.264, jeśli wysokie rozdzielczości się zacinają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O automático escolhe AV1, depois VP9 e depois H.264. Escolha H.264 se as resoluções altas travarem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatiskt väljer AV1, sedan VP9, sedan H.264. Välj H.264 om höga upplösningar hackar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“自动”依次选择 AV1、VP9，然后是 H.264。若高分辨率画面卡顿，请选择 H.264。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動」依序選擇 AV1、VP9、H.264。若高解析度播放卡頓，請選擇 H.264。"
          }
        }
      }
    },
