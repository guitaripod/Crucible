    "yt-dlp answered in a way Crucible couldn’t read. Updating yt-dlp usually fixes this." : {
      "comment" : "Web video error: unexpected output",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "yt-dlp svarede på en måde, Crucible ikke kan læse. Opdatering af yt-dlp løser typisk det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "yt-dlp hat auf eine Weise geantwortet, die Crucible nicht lesen konnte. Ein Update von yt-dlp behebt das meist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "yt-dlp respondió de una forma que Crucible no pudo leer. Actualizar yt-dlp suele solucionarlo."
