    "Large shows fewer, bigger posters in each library." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stor viser færre, større plakater i hvert bibliotek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groß zeigt weniger, dafür größere Poster pro Mediathek."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grande muestra menos pósteres, más grandes, en cada biblioteca."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suuri näyttää kussakin kirjastossa vähemmän ja suurempia julisteita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grande affiche : moins d’affiches, plus grandes, dans chaque bibliothèque."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stór sýnir færri og stærri veggspjöld í hverju safni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grande mostra meno poster, più grandi, in ogni libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「大」にすると、各ライブラリで表示されるポスターは少なくなり、大きくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "크게 보기는 보관함마다 포스터를 더 적고 크게 보여줘요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stor viser færre, men større plakater i hvert bibliotek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duże pokazuje mniej, za to większe plakaty w każdej bibliotece."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grande mostra menos pôsteres, maiores, em cada biblioteca."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stor visar färre, större affischer i varje bibliotek."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大会在每个资料库中显示更少、更大的海报。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「大」會在每個媒體庫中顯示較少但較大的海報。"
          }
        }
      }
    },
