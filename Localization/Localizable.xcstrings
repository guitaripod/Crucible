            "value" : "Plex のコンピュータとこの Apple TV に Tailscale をインストールし、同じアカウントでサインインします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plex 컴퓨터와 이 Apple TV에 Tailscale을 설치하고 같은 계정으로 로그인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installer Tailscale på Plex-datamaskinen og på denne Apple TV-en, logget på med én og samme konto."
          }
        },
        "pl" : {
          "stringUnit" : {
