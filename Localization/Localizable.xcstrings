    "You're offline. Crucible will send this to Trakt when you're back." : {
      "comment" : "Trakt error when offline",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er offline. Crucible sender dette til Trakt, når du er online igen."
          }
        },
