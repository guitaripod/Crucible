    "This account doesn’t own or share a Plex Media Server. Sign in with the account that has your server, or add one by its address." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne konto ejer eller deler ikke en Plex Media Server. Log ind med kontoen, der har din server, eller tilføj den med dens adresse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Konto besitzt keinen Plex Media Server und ist auch nicht damit geteilt. Melde dich mit dem Konto an, das deinen Server hat, oder füge ihn per Adresse hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cuenta no es propietaria de ningún servidor de Plex Media Server ni lo tiene compartido. Inicia sesión con la cuenta que tiene tu servidor o añádelo por su dirección."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tällä tilillä ei ole omistettua eikä jaettua Plex Media Serveriä. Kirjaudu sisään tilillä, jolla palvelimesi on, tai lisää se osoitteella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce compte ne possède ni ne partage de serveur Plex Media Server. Connectez-vous avec le compte qui héberge votre serveur, ou ajoutez-le par son adresse."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þessi aðgangur á ekki Plex Media Server og deilir honum ekki. Skráðu þig inn með aðganginum sem á þjóninn þinn, eða bættu honum við með vistfangi hans."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo account non possiede né condivide un Plex Media Server. Accedi con l'account che ha il tuo server oppure aggiungine uno tramite indirizzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアカウントは Plex Media Server を所有または共有していません。サーバーのあるアカウントでサインインするか、アドレスでサーバーを追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 계정은 Plex Media Server를 소유하거나 공유받지 않았어요. 서버가 있는 계정으로 로그인하거나, 주소로 서버를 추가하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne kontoen verken eier eller deler en Plex Media Server. Logg på med kontoen som har serveren din, eller legg til en med adressen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To konto nie jest właścicielem ani nie udostępnia serwera Plex Media Server. Zaloguj się na konto, na którym jest Twój serwer, albo dodaj serwer przez jego adres."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta conta não possui nem compartilha um Plex Media Server. Entre com a conta que tem o seu servidor ou adicione um pelo endereço."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här kontot äger inte och delar inte heller någon Plex Media Server. Logga in med kontot som har din server, eller lägg till den med dess adress."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此账户既不拥有也未共享 Plex 媒体服务器。请使用拥有服务器的账户登录，或按地址添加服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此帳號並未擁有或共享 Plex 媒體伺服器。請使用擁有您伺服器的帳號登入，或以位址新增伺服器。"
          }
        }
      }
    },
