    "Month, Year, All and the library filter are part of Crucible Pro." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Måned, år, alle og biblioteksfilteret er en del af Crucible Pro."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monat, Jahr, Gesamt und der Mediathekfilter sind Teil von Crucible Pro."
