          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible behöver det för att hitta en server på ditt Wi-Fi. Slå på det för Crucible i Inställningar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible 需要此权限才能在你的 Wi-Fi 中查找服务器。请在“设置”中为 Crucible 开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
