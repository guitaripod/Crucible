    "Activity heatmap. %lld active days, busiest day with %lld plays." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivitetsoversigt. %lld aktive dage, travleste dag med %lld afspilninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivitätskarte. %lld aktive Tage, aktivster Tag mit %lld Wiedergaben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa de actividad. %lld días activos, el día más intenso con %lld reproducciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toimintakartta. %lld aktiivista päivää, vilkkaimpana päivänä %lld toistoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carte d’activité. %lld jours actifs, jour le plus chargé avec %lld lectures."
          }
        },
        "is" : {
          "stringUnit" : {
