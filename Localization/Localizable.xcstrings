        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 Crucible Server는 Crucible이 사용하는 Plex 서버가 아닌 다른 Plex 서버 옆에서 실행 중이에요."
          }
        },
        "nb" : {
          "stringUnit" : {
