    "Asks before the next episode once this many have played in a row without the remote." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spørger, før næste afsnit starter, når så mange afsnit er afspillet i træk uden fjernbetjening."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragt vor der nächsten Folge nach, wenn so viele Folgen ohne Fernbedienung hintereinander gespielt wurden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregunta antes del siguiente episodio cuando se hayan reproducido este número seguido sin usar el mando."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kysyy ennen seuraavaa jaksoa, kun näin monta on toistettu peräkkäin ilman kaukosäädintä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande avant l’épisode suivant lorsque ce nombre d’épisodes a été lu à la suite sans télécommande."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spyr áður en næsti þáttur byrjar þegar þessi fjöldi þátta hefur verið spilaður í röð án fjarstýringar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiede prima dell'episodio successivo dopo questo numero di episodi riprodotti di seguito senza usare il telecomando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモコン操作なしでこの回数連続再生すると、次のエピソードの前に確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "리모컨 조작 없이 이 횟수만큼 연속 재생되면 다음 에피소드 전에 물어봐요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spør før neste episode når så mange har spilt på rad uten fjernkontrollen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyta przed następnym odcinkiem, gdy tyle odcinków zostanie odtworzonych jeden po drugim bez użycia pilota."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergunta antes do próximo episódio quando esta quantidade tiver sido reproduzida seguida sem usar o controle."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frågar innan nästa avsnitt när så här många har spelats i rad utan fjärrkontrollen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若连续播放这么多集且期间未使用遥控器，将在下一集前询问。"
