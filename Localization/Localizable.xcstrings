    "%@ Every library keeps its tab." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Hvert bibliotek beholder sin fane."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Jede Mediathek behält ihren Reiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Cada biblioteca conserva su pestaña."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Jokainen kirjasto säilyttää välilehtensä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Chaque bibliothèque conserve son onglet."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Hvert safn heldur sínum flipa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Ogni libreria mantiene la propria scheda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ すべてのライブラリはそれぞれのタブを保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 모든 보관함이 각자의 탭을 유지해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Hvert bibliotek beholder sin fane."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Każda biblioteka zachowuje swoją kartę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Cada biblioteca mantém sua aba."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Varje bibliotek behåller sin flik."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 每个资料库都保留其标签页。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 每個媒體庫都會保留自己的分頁。"
          }
        }
      }
    },
    "%@ Fix one of these, or enter its address below." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Ret en af disse, eller indtast dens adresse nedenfor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Behebe eines davon oder gib unten seine Adresse ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Corrige una de estas opciones o introduce su dirección abajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Korjaa yksi näistä tai anna sen osoite alla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Corrigez l’une de ces adresses ou saisissez la vôtre ci-dessous."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Lagfærðu eitt af þessu, eða sláðu inn vistfang hér fyrir neðan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Correggi uno di questi, oppure inserisci il suo indirizzo qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ いずれかを修正するか、下にアドレスを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 아래 방법 중 하나로 해결하거나 주소를 직접 입력해 보세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Fiks ett av disse, eller skriv inn adressen nedenfor."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Napraw jedną z nich albo wpisz jej adres poniżej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Corrija um destes ou informe o endereço abaixo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Åtgärda ett av dessa eller ange dess adress nedan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 请修复其中一项，或在下方输入其地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 請修正其中一項，或在下方輸入位址。"
          }
        }
      }
    },
