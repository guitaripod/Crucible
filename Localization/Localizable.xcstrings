    "To add an Apple TV, choose Pair with iPhone on the TV, or scan the code it shows with the Camera." : {
      "comment" : "Footer under Crucible Server settings on iPhone when paired",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at tilføje en Apple TV skal du på tv’et vælge Par med iPhone eller scanne den kode, det viser, med kameraet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um einen Apple TV hinzuzufügen, wähle auf dem Fernseher „Mit iPhone koppeln“ oder scanne den angezeigten Code mit der Kamera."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para añadir un Apple TV, elige Vincular con iPhone en el televisor o escanea con la Cámara el código que muestra."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos haluat lisätä Apple TV:n, valitse televisiosta Muodosta pari iPhonen kanssa tai skannaa sen näyttämä koodi kameralla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour ajouter une Apple TV, choisissez Appairer avec un iPhone sur le téléviseur, ou scannez avec l’appareil photo le code qu’elle affiche."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Til að bæta við Apple TV skaltu velja „Para saman við iPhone“ í sjónvarpinu eða skanna kóðann sem það sýnir með myndavélinni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per aggiungere un’Apple TV, scegli Abbina con iPhone sulla TV oppure inquadra con la Fotocamera il codice che mostra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV を追加するには、テレビで「iPhoneとペアリング」を選ぶか、表示されたコードをカメラでスキャンしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV를 추가하려면 TV에서 ‘iPhone과 페어링’을 선택하거나 TV에 표시된 코드를 카메라로 스캔하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å legge til en Apple TV, velg «Koble sammen med iPhone» på TV-en, eller skann koden den viser med kameraet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby dodać Apple TV, wybierz na telewizorze Paruj z iPhonem albo zeskanuj aparatem kod, który on pokazuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para adicionar uma Apple TV, escolha Parear com iPhone na TV ou escaneie com a Câmera o código que ela mostra."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du vill lägga till en Apple TV väljer du ”Koppla ihop med iPhone” på TV:n, eller skannar koden den visar med kameran."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要添加 Apple TV，请在电视上选择“与 iPhone 配对”，或用相机扫描它显示的代码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要新增 Apple TV，請在電視上選擇「與 iPhone 配對」，或用相機掃描它顯示的代碼。"
          }
        }
      }
    },
    "To manage or cancel: Settings > Users & Accounts > your account > Subscriptions" : {
