    "Fetches new episodes as you watch and removes watched ones." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henter nye afsnit, mens du ser, og fjerner dem, du har set."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt neue Folgen, während du schaust, und entfernt gesehene."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtiene nuevos episodios a medida que ves y elimina los vistos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hakee uudet jaksot katsoessasi ja poistaa katsotut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Récupère les nouveaux épisodes au fil de vos lectures et supprime ceux que vous avez vus."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sækir nýja þætti þegar þú horfir og fjarlægir þá sem þú hefur séð."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica i nuovi episodi mentre guardi e rimuove quelli visti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視聴に合わせて新しいエピソードを取得し、視聴済みのものを削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보는 동안 새 에피소드를 가져오고, 시청한 에피소드는 삭제해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henter nye episoder mens du ser, og fjerner dem du har sett."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobiera nowe odcinki w miarę oglądania i usuwa obejrzane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca novos episódios conforme você assiste e remove os já assistidos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hämtar nya avsnitt allteftersom du tittar och tar bort de du har sett."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随着你的观看获取新剧集，并移除已看完的剧集。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在您觀看時擷取新集數，並移除已看完的集數。"
          }
        }
      }
    },
