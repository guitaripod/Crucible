        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W TrueNAS otwórz Apps, wybierz Discover Apps, wyszukaj Seerr i zainstaluj go. Zostaw port webowy 5055, pod którym szuka Crucible."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No TrueNAS, abra Apps, escolha Discover Apps, procure o Seerr e instale-o. Mantenha a porta web em 5055, que é onde o Crucible procura."
          }
