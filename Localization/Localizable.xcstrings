    "Frees the space posters and backdrops take on this device." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frigør den plads, plakater og baggrunde optager på denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt den Speicherplatz frei, den Poster und Hintergründe auf diesem Gerät belegen."
