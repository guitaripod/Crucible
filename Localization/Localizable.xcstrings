          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak Crucible odtwarza to, co wybierzesz z serwera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como o Crucible reproduz o que você escolhe do seu servidor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible 如何播放你从服务器中选择的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說明 Crucible 如何播放您從伺服器選取的內容。"
          }
        }
      }
    },
    "How far one skip goes: a click on the left or right of the Siri Remote's clickpad, or the skip buttons on the Lock Screen, in Control Center and on headphones." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie weit ein Sprung geht: ein Klick links oder rechts auf dem Clickpad der Siri Remote oder die Sprungtasten auf dem Sperrbildschirm, im Kontrollzentrum und auf Kopfhörern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto avanza o retrocede cada salto: un clic a la izquierda o derecha del touchpad del Siri Remote, o los botones de salto en la pantalla de bloqueo, en el Centro de control y en los auriculares."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durée d’un saut : un clic à gauche ou à droite du pavé tactile de la Siri Remote, ou les boutons de saut de l’écran verrouillé, du Centre de contrôle et des écouteurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto avanza ogni salto: un clic a sinistra o a destra del clickpad del Siri Remote, oppure i pulsanti di salto nella schermata di blocco, in Centro di controllo e sulle cuffie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 回のスキップの幅: Siri リモコンのクリックパッドの左右のクリック、またはロック画面、コントロールセンター、ヘッドフォンのスキップボタンです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번 건너뛸 때 이동하는 길이예요. Siri 리모컨 클릭패드의 왼쪽이나 오른쪽을 클릭하거나, 잠금 화면, 제어 센터, 헤드폰의 건너뛰기 버튼을 사용할 때 적용돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak daleko sięga jedno przeskoczenie: kliknięcie po lewej lub prawej stronie touchpada Siri Remote albo przyciski pomijania na ekranie blokady, w Centrum sterowania i na słuchawkach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Até onde vai cada salto: um clique na esquerda ou na direita do touchpad do Siri Remote, ou os botões de pular na Tela de Bloqueio, na Central de Controle e nos fones de ouvido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单次跳过的时长：点按 Siri 遥控器触控板的左侧或右侧，或使用锁定屏幕、控制中心和耳机上的跳过按钮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "單次跳轉的距離：按下 Siri 遙控器觸控板的左側或右側，或使用鎖定畫面、控制中心及耳機上的跳轉按鈕。"
          }
        }
      }
    },
