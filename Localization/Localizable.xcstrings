    "Skip Credits decides what the credits do: show the Up Next card, start the next episode automatically, or stay out of the way." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abspann überspringen legt fest, was beim Abspann passiert: Karte „Als Nächstes“ zeigen, die nächste Folge automatisch starten oder nichts tun."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saltar créditos decide qué hacen los créditos: mostrar la tarjeta A continuación, empezar el siguiente episodio automáticamente o no molestar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Passer le générique » détermine ce qui se passe pendant le générique : afficher la carte « À suivre », lancer automatiquement l’épisode suivant, ou ne rien faire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta titoli di coda decide cosa fanno i titoli di coda: mostrare la scheda Prossimo, avviare automaticamente l'episodio successivo o non intervenire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「エンドクレジットをスキップ」では、エンドクレジット中の動作を選べます。「次に見る」カードを表示する、次のエピソードを自動で再生する、何もしない、のいずれかです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "엔딩 크레딧 건너뛰기 설정은 엔딩 크레딧 동안 다음 재생 카드를 보여줄지, 다음 에피소드를 자동으로 시작할지, 아무것도 하지 않을지 정해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomiń napisy końcowe decyduje, co dzieje się z napisami: pokazać kartę Następne, automatycznie uruchomić kolejny odcinek albo nic nie robić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pular créditos define o que acontece nos créditos: mostrar o cartão A seguir, iniciar o próximo episódio automaticamente ou não interferir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“跳过片尾”决定片尾时的操作：显示“接下来播放”卡片、自动开始下一集，或不做任何干扰。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「跳過片尾」決定片尾時要如何處理：顯示接著播放卡片、自動開始下一集，或不做任何處理。"
          }
        }
      }
    },
