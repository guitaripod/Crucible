    "That Apple TV code has expired. Show a new one on the Apple TV, then scan it again." : {
      "comment" : "iPhone message when the scanned Apple TV code is too old",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV-koden er udløbet. Vis en ny på Apple TV, og scan den igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Apple-TV-Code ist abgelaufen. Lass auf dem Apple TV einen neuen anzeigen und scanne ihn erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese código del Apple TV ha caducado. Muestra uno nuevo en el Apple TV y vuelve a escanearlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämän Apple TV:n koodi on vanhentunut. Näytä uusi koodi Apple TV:ssä ja skannaa se uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce code d’Apple TV a expiré. Affichez-en un nouveau sur l’Apple TV, puis scannez-le à nouveau."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þessi Apple TV-kóði er útrunninn. Láttu sýna nýjan á Apple TV og skannaðu hann svo aftur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quel codice dell’Apple TV è scaduto. Mostrane uno nuovo sull’Apple TV, poi inquadralo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その Apple TV のコードは期限切れです。Apple TV で新しいコードを表示して、もう一度スキャンしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 Apple TV 코드는 만료됐어요. Apple TV에서 새 코드를 표시한 다음 다시 스캔하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne Apple TV-koden er utløpt. Vis en ny på Apple TV, og skann den igjen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten kod z Apple TV wygasł. Wyświetl nowy na Apple TV, a potem zeskanuj go ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esse código da Apple TV expirou. Mostre um novo na Apple TV e escaneie-o de novo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här Apple TV-koden har gått ut. Visa en ny på Apple TV och skanna den igen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该 Apple TV 代码已过期。请在 Apple TV 上显示新代码，然后重新扫描。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該 Apple TV 代碼已過期。請在 Apple TV 上顯示新代碼，然後重新掃描。"
          }
        }
      }
    },
    "That Crucible Server runs beside a different Plex server than the one Crucible is using." : {
      "comment" : "Crucible Server error when the server belongs to another Plex server",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne Crucible Server kører sammen med en anden Plex-server end den, Crucible bruger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Crucible Server läuft neben einem anderen Plex-Server als dem, den Crucible verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese Crucible Server funciona junto a un servidor Plex distinto del que usa Crucible."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä Crucible Server toimii eri Plex-palvelimen rinnalla kuin se, jota Crucible käyttää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Crucible Server tourne à côté d’un autre serveur Plex que celui qu’utilise Crucible."
          }
