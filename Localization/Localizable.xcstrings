    "That pairing code is wrong or has expired. Run crucible-server pair for a new one." : {
      "comment" : "Crucible Server error",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parringskoden er forkert eller udløbet. Kør crucible-server pair for at få en ny."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Kopplungscode ist falsch oder abgelaufen. Führe crucible-server pair aus, um einen neuen zu erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese código de vinculación es incorrecto o ha caducado. Ejecuta crucible-server pair para obtener uno nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä parinmuodostuskoodi on väärä tai vanhentunut. Suorita crucible-server pair saadaksesi uuden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce code d’appairage est incorrect ou a expiré. Exécutez crucible-server pair pour en obtenir un nouveau."
