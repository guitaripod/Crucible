    "Titles whose files are gone leave the library for good." : {
      "comment" : "Confirmation message for emptying a library's trash",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titler, hvis filer er væk, forsvinder fra biblioteket for altid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titel, deren Dateien fehlen, verschwinden endgültig aus der Mediathek."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los títulos cuyos archivos ya no están salen de la biblioteca para siempre."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimikkeet, joiden tiedostot puuttuvat, poistuvat kirjastosta lopullisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les titres dont les fichiers ont disparu quittent définitivement la bibliothèque."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titlar þar sem skrárnar eru horfnar fara úr safninu fyrir fullt og allt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I titoli di cui non ci sono più i file escono definitivamente dalla libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルがなくなったタイトルは、ライブラリから完全に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일이 없어진 제목은 보관함에서 영구히 사라져요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titler hvis filer er borte, forsvinner fra biblioteket for godt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tytuły, których pliki zniknęły, zostaną trwale usunięte z biblioteki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Títulos cujos arquivos sumiram saem da biblioteca de vez."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titlar vars filer är borta försvinner från biblioteket för gott."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件已不存在的标题将永久从资料库中移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檔案已不存在的作品會永久從媒體庫移除。"
          }
        }
      }
    },
