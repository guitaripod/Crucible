    "This profile can’t use this server. The server’s owner can share it with them in Plex." : {
      "comment" : "Error when a Plex Home profile has no access to the current server",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne profil kan ikke bruge denne server. Serverens ejer kan dele den med profilen i Plex."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Profil kann diesen Server nicht nutzen. Der Besitzer des Servers kann ihn in Plex für dieses Profil freigeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil no puede usar este servidor. El propietario del servidor puede compartírselo en Plex."
