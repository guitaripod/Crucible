          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização Plex do próprio Trakt está ativa. Se os dois registrarem, cada episódio conta duas vezes. Escolha um."
          }
        },
        "sv" : {
          "stringUnit" : {
