        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在網路變更前持續使用此連線"
          }
        }
      }
    },
    "Uses your home network's address for the server whenever it answers there." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
