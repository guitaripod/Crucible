            "value" : "Crucible scrobbelt nicht mehr und behält alles andere bei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible deja de hacer scrobbling y mantiene todo lo demás."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible lopettaa katselujen lähettämisen Traktiin ja säilyttää kaiken muun."
          }
