            "value" : "Lädt neue Folgen, während du schaust, und entfernt gesehene."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtiene nuevos episodios a medida que ves y elimina los vistos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Récupère les nouveaux épisodes au fil de vos lectures et supprime ceux que vous avez vus."
          }
        },
        "it" : {
