    "Rate What You Watched starts empty and no reminder is sent for anything finished so far." : {
      "comment" : "Confirmation message for clearing the Rate What You Watched history",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Bewerte, was du gesehen hast“ beginnt leer, und für bisher Abgeschlossenes wird keine Erinnerung gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valora lo que viste empieza vacío y no se envía ningún recordatorio por lo que hayas terminado hasta ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Noter ce que vous avez regardé » repart de zéro, et aucun rappel n’est envoyé pour ce que vous avez terminé jusqu’ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valuta cosa hai guardato riparte vuoto e non viene inviato alcun promemoria per quanto finito finora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「視聴した作品を評価」は空の状態から始まり、これまでに視聴を終えた作品のリマインダーは送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시청 후 평점 주기 목록이 비어 있게 되고, 지금까지 다 본 항목에 대해서는 알림을 보내지 않아요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oceń obejrzane zacznie się od pustej listy i nie zostaną wysłane przypomnienia o tym, co dotąd ukończono."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avalie o que você assistiu começa vazio, e nenhum lembrete é enviado para o que já foi terminado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“看完后评分”将重新开始为空，之前看完的内容不会发送提醒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「已看完，請評分」會清空，目前已看完的內容不會再發出提醒。"
          }
        }
      }
    },
