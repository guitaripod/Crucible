    "Seerr didn't let this Plex account in. Ask whoever runs it to import or allow your account." : {
      "comment" : "Seerr error when the Plex account is refused",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seerr lukkede ikke denne Plex-konto ind. Bed den, der administrerer Seerr, om at importere eller give din konto adgang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seerr hat dieses Plex-Konto nicht eingelassen. Bitte den Betreiber, dein Konto zu importieren oder freizugeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seerr no dejó entrar a esta cuenta de Plex. Pide a quien lo gestiona que importe o permita tu cuenta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seerr ei päästänyt tätä Plex-tiliä sisään. Pyydä sen ylläpitäjää tuomaan tai sallimaan tilisi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seerr n'a pas laissé entrer ce compte Plex. Demandez à son administrateur d'importer ou d'autoriser votre compte."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seerr hleypti þessum Plex-aðgangi ekki inn. Biddu þann sem sér um það að flytja inn eða heimila aðganginn þinn."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seerr non ha fatto entrare questo account Plex. Chiedi a chi lo gestisce di importare o autorizzare il tuo account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SeerrがこのPlexアカウントを許可しませんでした。Seerrの管理者にアカウントのインポートまたは許可を依頼してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seerr가 이 Plex 계정의 접근을 허용하지 않았어요. Seerr 관리자에게 계정을 가져오거나 허용해 달라고 요청해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seerr slapp ikke inn denne Plex-kontoen. Spør den som driver Seerr om å importere eller godkjenne kontoen din."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seerr nie wpuścił tego konta Plex. Poproś administratora o zaimportowanie lub dopuszczenie Twojego konta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Seerr não deixou esta conta do Plex entrar. Peça a quem administra para importar ou liberar sua conta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seerr släppte inte in det här Plex-kontot. Be den som kör Seerr att importera eller tillåta ditt konto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seerr 不允许此 Plex 账户登录。请让管理者导入或允许你的账户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seerr 不允許此 Plex 帳號登入。請詢問管理者匯入或允許你的帳號。"
          }
        }
      }
    },
    "Seerr doesn't know this title." : {
