    "The demo library and your progress in it are removed, and you return to the welcome screen." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demo-biblioteket og din fremgang i det fjernes, og du vender tilbage til velkomstskærmen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Demo-Mediathek und dein Fortschritt darin werden entfernt, und du kehrst zum Begrüßungsbildschirm zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminan la biblioteca de demostración y tu progreso en ella, y vuelves a la pantalla de bienvenida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demokirjasto ja sen edistyminen poistetaan, ja palaat tervetulonäyttöön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bibliothèque de démonstration et votre progression sont supprimées, et vous revenez à l’écran d’accueil."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kynningarsafnið og framvinda þín í því eru fjarlægð og þú ferð aftur á upphafsskjáinn."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La libreria demo e i tuoi progressi al suo interno vengono rimossi e torni alla schermata di benvenuto."
          }
        },
        "ja" : {
