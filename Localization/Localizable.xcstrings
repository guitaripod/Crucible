    "Applies to subtitles the server draws into the picture and to the ones the player draws." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für Untertitel, die der Server ins Bild einbrennt, und für die, die der Player zeichnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a los subtítulos que el servidor incrusta en la imagen y a los que dibuja el reproductor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique aux sous-titres incrustés dans l’image par le serveur et à ceux que le lecteur affiche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale per i sottotitoli che il server inserisce nell'immagine e per quelli che disegna il lettore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーが映像に描き込む字幕と、プレーヤーが描く字幕の両方に適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버가 화면에 입히는 자막과 플레이어가 그리는 자막 모두에 적용돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotyczy napisów, które serwer wpisuje w obraz, i tych, które rysuje odtwarzacz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
