    "Profiles for the people you live with are set up in Plex, under Plex Home." : {
      "comment" : "Explanation when the account has no Plex Home profiles",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiler til de personer, du bor sammen med, oprettes i Plex under Plex Home."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile für die Menschen, mit denen du zusammenlebst, richtest du in Plex unter Plex Home ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los perfiles para las personas con las que vives se configuran en Plex, en Plex Home."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kotitaloutesi profiilit luodaan Plexissä kohdassa Plex Home."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les profils des personnes avec qui vous vivez se configurent dans Plex, sous Plex Home."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prófílar fyrir fólkið sem þú býrð með eru settir upp í Plex undir Plex Home."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I profili per le persone con cui vivi si configurano in Plex, sotto Plex Home."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一緒に暮らす人のプロフィールは、Plex の Plex Home で設定します。"
