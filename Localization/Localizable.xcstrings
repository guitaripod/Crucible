    "Swipe left or right to choose, press to rate" : {
      "comment" : "Hint under the star rating control on Apple TV",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stryg til venstre eller højre for at vælge, tryk for at bedømme"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach links oder rechts wischen zum Auswählen, drücken zum Bewerten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza a la izquierda o a la derecha para elegir, pulsa para valorar"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyyhkäise vasemmalle tai oikealle valitaksesi, arvostele painamalla"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez vers la gauche ou la droite pour choisir, appuyez pour noter"
          }
        },
        "is" : {
          "stringUnit" : {
