    "The purchase could not be completed. You have not been charged. Try again, or use Restore Purchases if you already own Pro." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kauf konnte nicht abgeschlossen werden. Dir wurde nichts berechnet. Versuche es erneut oder nutze „Käufe wiederherstellen“, wenn du Pro bereits besitzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo completar la compra. No se te ha cobrado nada. Inténtalo de nuevo o usa Restaurar compras si ya tienes Pro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’achat n’a pas pu être finalisé. Aucun montant ne vous a été débité. Réessayez ou utilisez Restaurer les achats si vous possédez déjà Pro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'acquisto non è stato completato. Non ti è stato addebitato nulla. Riprova oppure usa Ripristina acquisti se possiedi già Pro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購入を完了できませんでした。料金は請求されていません。もう一度お試しいただくか、Pro をすでに所有している場合は「購入を復元」を使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구매를 완료할 수 없었어요. 요금은 청구되지 않았어요. 다시 시도하거나, 이미 Pro를 구매했다면 구매 복원을 사용하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się dokończyć zakupu. Nie pobrano opłaty. Spróbuj ponownie albo użyj Przywróć zakupy, jeśli masz już Pro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível concluir a compra. Você não foi cobrado. Tente novamente ou use Restaurar compras se já tiver o Pro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法完成购买。你未被扣费。请重试，如果你已拥有 Pro，请使用“恢复购买”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
