    "Movies and episodes you download appear here, ready to watch offline." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Film og afsnit, du henter, vises her, klar til at se offline."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filme und Folgen, die du herunterlädst, erscheinen hier und sind bereit für die Offline-Wiedergabe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las películas y los episodios que descargues aparecerán aquí, listos para verse sin conexión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lataamasi elokuvat ja jaksot näkyvät tässä, valmiina katsottavaksi offline-tilassa."
