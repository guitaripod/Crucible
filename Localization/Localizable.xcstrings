        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun elokuva tai sarjan viimeinen jakso päättyy, samankaltaiset nimikkeet odottavat ruudulla soittimen sulkeutumisen sijaan."
