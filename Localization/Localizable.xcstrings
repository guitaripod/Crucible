    "Find it in Seerr under Settings › General. Requests made with it are made as Seerr's administrator." : {
      "comment" : "Message of the prompt for the Seerr API key",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find den i Seerr under Indstillinger › Generelt. Anmodninger, der sendes med den, sendes som Seerr-administrator."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du findest ihn in Seerr unter Einstellungen › Allgemein. Anfragen damit gelten als Seerr-Administrator."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuéntrala en Seerr, en Ajustes › General. Las solicitudes hechas con ella se hacen como administrador de Seerr."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löydät sen Seerristä kohdasta Asetukset › Yleiset. Sillä tehdyt pyynnöt tehdään Seerrin ylläpitäjänä."
          }
