    "This deletes the files of %@ from your server's disk. It cannot be undone, and the server only allows it when Allow Media Deletion is on in its settings." : {
      "comment" : "Confirmation message for deleting a title from the server",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette sletter filerne til %@ fra din servers disk. Det kan ikke fortrydes, og serveren tillader det kun, når »Tillad mediesletning« er slået til i dens indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden die Dateien von %@ von der Festplatte deines Servers gelöscht. Das lässt sich nicht rückgängig machen. Der Server erlaubt das nur, wenn „Medienlöschung erlauben“ in seinen Einstellungen aktiviert ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina los archivos de %@ del disco de tu servidor. No se puede deshacer, y el servidor solo lo permite cuando «Permitir la eliminación de medios» está activado en sus ajustes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä poistaa nimikkeen %@ tiedostot palvelimen levyltä. Toimintoa ei voi peruuttaa, ja palvelin sallii sen vain, kun ”Salli median poistaminen” on päällä sen asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime les fichiers de %@ du disque de votre serveur. Cette action est irréversible, et le serveur ne l’autorise que si « Autoriser la suppression de médias » est activé dans ses réglages."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þetta eyðir skrár %@ af diski þjónsins þíns. Ekki er hægt að afturkalla það, og þjónninn leyfir það aðeins þegar „Leyfa eyðingu margmiðlunarefnis“ er kveikt í stillingum hans."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo elimina i file di %@ dal disco del server. Non si può annullare, e il server lo consente solo quando Consenti eliminazione dei contenuti multimediali è attivo nelle sue impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーのディスクから %@ のファイルを削除します。元に戻すことはできません。サーバーの設定で「メディアの削除を許可」がオンの場合にのみ削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버 디스크에서 %@ 파일을 삭제해요. 되돌릴 수 없으며, 서버 설정의 “Allow Media Deletion”이 켜져 있을 때만 가능해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette sletter filene til %@ fra serverens disk. Det kan ikke angres, og serveren tillater det bare når «Tillat mediesletting» er på i innstillingene."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To usunie pliki: %@ z dysku serwera. Nie można tego cofnąć, a serwer pozwala na to tylko wtedy, gdy w jego ustawieniach włączono Zezwalaj na usuwanie multimediów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso exclui os arquivos de %@ do disco do seu servidor. Não é possível desfazer, e o servidor só permite isso quando Permitir exclusão de mídia está ativado nos ajustes dele."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta raderar filerna för %@ från din servers disk. Det kan inte ångras, och servern tillåter det bara när ”Tillåt mediaradering” är på i dess inställningar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将从服务器磁盘中删除 %@ 的文件。此操作无法撤销，且只有在服务器设置中开启“允许删除媒体”时才能执行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會從伺服器的磁碟刪除 %@ 的檔案。此操作無法復原，且伺服器只有在其設定中開啟「允許刪除媒體」時才允許。"
          }
        }
      }
    },
    "This device isn't paired with Crucible Server any more. Pair it again." : {
      "comment" : "Crucible Server error",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
