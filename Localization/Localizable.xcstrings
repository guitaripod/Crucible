    "Movies and episodes you download appear here, ready to watch offline." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filme und Folgen, die du herunterlädst, erscheinen hier und sind bereit für die Offline-Wiedergabe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las películas y los episodios que descargues aparecerán aquí, listos para verse sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les films et épisodes que vous téléchargez apparaissent ici, prêts à être regardés hors ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I film e gli episodi che scarichi appaiono qui, pronti per essere guardati offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードした映画やエピソードがここに表示され、オフラインで視聴できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드한 영화와 에피소드가 여기에 표시되고, 오프라인에서 볼 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filmy i odcinki, które pobierzesz, pojawią się tutaj, gotowe do oglądania offline."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os filmes e episódios que você baixar aparecem aqui, prontos para assistir offline."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你下载的电影和剧集会显示在此处，可随时离线观看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您下載的電影與集數會出現在這裡，可離線觀看。"
          }
        }
      }
    },
    "Movies and episodes you started, with the latest one as the big card at the top." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filme und Folgen, die du begonnen hast, der neueste als große Karte oben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Películas y episodios que empezaste, con el más reciente como tarjeta grande arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Films et épisodes commencés, le plus récent en grande carte en haut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Film ed episodi che hai iniziato, con l'ultimo come scheda grande in cima."
