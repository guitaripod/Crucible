    "Skip Intro can show a button, skip automatically, or stay out of the way." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spring intro over kan vise en knap, springe automatisk over eller holde sig ude af vejen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intro überspringen kann eine Schaltfläche anzeigen, automatisch überspringen oder sich zurückhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saltar intro puede mostrar un botón, saltar automáticamente o no intervenir."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohita intro voi näyttää painikkeen, ohittaa sen automaattisesti tai jättää sen rauhaan."
