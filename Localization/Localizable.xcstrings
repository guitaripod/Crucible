    "%@ of watching this week, %lld%% less than last week." : {
      "comment" : "Weekly recap body with a fall",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ set denne uge, %lld%% mindre end sidste uge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Schauzeit diese Woche, %lld%% weniger als letzte Woche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de visionado esta semana, un %lld%% menos que la semana pasada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ katseluaikaa tällä viikolla, %lld%% vähemmän kuin viime viikolla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de visionnage cette semaine, %lld%% de moins que la semaine dernière."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ áhorf þessa viku, %lld%% minna en síðustu viku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ di visione questa settimana, %lld%% in meno rispetto alla settimana scorsa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今週の視聴は %@、先週より %lld%% 少なくなっています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 주 시청 %@, 지난주보다 %lld%% 적어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ seertid denne uken, %lld%% mindre enn forrige uke."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ oglądania w tym tygodniu, o %lld%% mniej niż w zeszłym tygodniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de exibição esta semana, %lld%% a menos que na semana passada."
          }
