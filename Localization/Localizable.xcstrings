    "Each profile has its own Continue Watching, watched titles, ratings and watchlist." : {
      "comment" : "Explanation beside the Plex Home profile list on Apple TV",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Profil hat sein eigenes Weiterschauen, gesehene Titel, Bewertungen und seine eigene Watchlist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada perfil tiene su propio Seguir viendo, sus títulos vistos, sus valoraciones y su lista para ver."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque profil a son propre Reprendre la lecture, ses titres vus, ses évaluations et sa liste de suivi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni profilo ha il proprio Continua a guardare, i titoli visti, le valutazioni e la propria Watchlist."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各プロフィールには、それぞれの「続きを見る」、視聴済みのタイトル、評価、ウォッチリストがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로필마다 이어보기, 시청한 작품, 평점, 관심 목록이 따로 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy profil ma własne Kontynuuj oglądanie, obejrzane tytuły, oceny i listę do obejrzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada perfil tem seus próprios Continuar assistindo, títulos assistidos, avaliações e Lista para assistir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个个人资料都有各自的“继续观看”、已看标题、评分和待看列表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個個人檔案都有各自的「繼續觀看」、已看作品、評分與待看清單。"
          }
        }
      }
    },
    "Each profile has its own Continue Watching, watched titles, ratings and watchlist. Downloads stay on this device." : {
      "comment" : "Footer under the Plex Home profile list",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Profil hat sein eigenes Weiterschauen, gesehene Titel, Bewertungen und seine eigene Watchlist. Downloads bleiben auf diesem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada perfil tiene su propio Seguir viendo, sus títulos vistos, sus valoraciones y su lista para ver. Las descargas se quedan en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque profil a son propre Reprendre la lecture, ses titres vus, ses évaluations et sa liste de suivi. Les téléchargements restent sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni profilo ha il proprio Continua a guardare, i titoli visti, le valutazioni e la propria Watchlist. I download restano su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各プロフィールには、それぞれの「続きを見る」、視聴済みのタイトル、評価、ウォッチリストがあります。ダウンロードはこのデバイスに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로필마다 이어보기, 시청한 작품, 평점, 관심 목록이 따로 있어요. 다운로드는 이 기기에만 남아요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy profil ma własne Kontynuuj oglądanie, obejrzane tytuły, oceny i listę do obejrzenia. Pobrane pliki pozostają na tym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada perfil tem seus próprios Continuar assistindo, títulos assistidos, avaliações e Lista para assistir. Os downloads ficam neste aparelho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个个人资料都有各自的“继续观看”、已看标题、评分和待看列表。下载内容仅保存在此设备上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個個人檔案都有各自的「繼續觀看」、已看作品、評分與待看清單。下載內容會保留在這部裝置上。"
          }
        }
      }
