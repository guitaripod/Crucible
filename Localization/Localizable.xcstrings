          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible esce da Seerr su questo dispositivo. Le tue richieste restano in Seerr."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末ではCrucibleからSeerrをサインアウトします。リクエストはSeerrに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서 Crucible이 Seerr에서 로그아웃해요. 요청은 Seerr에 그대로 남아요."
          }
        },
        "nb" : {
          "stringUnit" : {
