    "Enter a hostname or IP address, optionally with a port." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib einen Hostnamen oder eine IP-Adresse ein, optional mit Port."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce un nombre de host o una dirección IP, opcionalmente con puerto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez un nom d’hôte ou une adresse IP, avec un port si besoin."
          }
        },
        "it" : {
