    "The newest lines of Crucible’s log. Focus the log and swipe to read older entries." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De nyeste linjer i Crucibles log. Fokusér loggen, og stryg for at læse ældre poster."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die neuesten Zeilen aus Crucibles Protokoll. Fokussiere das Protokoll und wische, um ältere Einträge zu lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las líneas más recientes del registro de Crucible. Enfoca el registro y desliza para leer las entradas más antiguas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible-lokin uusimmat rivit. Kohdista loki ja pyyhkäise lukeaksesi vanhempia merkintöjä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dernières lignes du journal de Crucible. Sélectionnez le journal et balayez pour lire les entrées plus anciennes."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nýjustu línurnar í atburðaskrá Crucible. Veldu atburðaskrána og strjúktu til að lesa eldri færslur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le righe più recenti del log di Crucible. Metti a fuoco il log e scorri per leggere le voci più vecchie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible のログの最新の行です。ログにフォーカスして、スワイプすると古いエントリを読めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible 로그의 최신 줄이에요. 로그에 초점을 맞추고 밀어서 이전 항목을 읽으세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De nyeste linjene i Crucibles logg. Fokuser loggen og sveip for å lese eldre oppføringer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najnowsze wiersze dziennika Crucible. Ustaw fokus na dzienniku i przesuwaj, aby czytać starsze wpisy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As linhas mais recentes do registro do Crucible. Foque o registro e deslize para ler as entradas mais antigas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De senaste raderna i Crucibles logg. Fokusera loggen och svep för att läsa äldre poster."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible 日志的最新行。聚焦日志后滑动可查看更早的条目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
