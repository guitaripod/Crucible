      }
    },
    "Tailscale didn't accept that token. Check that you copied all of it and that it hasn't expired." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale hat dieses Token nicht akzeptiert. Prüfe, ob du es vollständig kopiert hast und es nicht abgelaufen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale no aceptó ese token. Comprueba que lo has copiado completo y que no haya caducado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale n’a pas accepté ce jeton. Vérifiez que vous l’avez copié en entier et qu’il n’a pas expiré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale non ha accettato quel token. Controlla di averlo copiato per intero e che non sia scaduto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale がそのトークンを受け付けませんでした。すべてコピーしたか、期限切れでないかを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale이 해당 토큰을 받아들이지 않았어요. 토큰을 전부 복사했는지, 만료되지 않았는지 확인하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale nie zaakceptował tego tokenu. Sprawdź, czy skopiowano go w całości i czy nie wygasł."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Tailscale não aceitou esse token. Verifique se você copiou tudo e se ele não expirou."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale 不接受该令牌。请检查是否完整复制，并确认它没有过期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale 不接受此權杖。請確認已完整複製，且權杖尚未過期。"
          }
        }
      }
    },
    "Tap a star to rate, or slide across the stars for half stars." : {
      "comment" : "Hint above the Rate What You Watched list, whose rows each carry five stars",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf einen Stern, um zu bewerten, oder wische über die Sterne für halbe Sterne."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una estrella para valorar o desliza por las estrellas para dar medias estrellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une étoile pour noter, ou faites glisser le doigt sur les étoiles pour des demi-étoiles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca una stella per valutare, oppure scorri sulle stelle per le mezze stelle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "星をタップして評価。星の上をなぞると半分の星も付けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "별을 탭해 평가하거나, 별 위를 밀어서 반 별을 매기세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij gwiazdkę, aby ocenić, lub przesuń palcem po gwiazdkach, by dać pół gwiazdki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em uma estrela para avaliar ou deslize sobre as estrelas para dar meia estrela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点星星即可评分，在星星上滑动可评半星。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下星星即可評分，在星星上滑動可評半顆星。"
          }
        }
      }
    },
    "Tap to rate it, or press and hold for quick stars." : {
      "comment" : "Body of a reminder to rate a title the viewer finished",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe, um zu bewerten, oder drücke lange für schnelle Sterne."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca para valorarlo, o mantén pulsado para valorar rápido con estrellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez pour le noter, ou appuyez longuement pour noter rapidement avec des étoiles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca per valutarlo, o tieni premuto per le stelle veloci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タップして評価するか、長押しで星をすばやく付けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
