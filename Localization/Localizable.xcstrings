    "Asks before the next episode once this many have played in a row without the remote." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragt vor der nächsten Folge nach, wenn so viele Folgen ohne Fernbedienung hintereinander gespielt wurden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregunta antes del siguiente episodio cuando se hayan reproducido este número seguido sin usar el mando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande avant l’épisode suivant lorsque ce nombre d’épisodes a été lu à la suite sans télécommande."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiede prima dell'episodio successivo dopo questo numero di episodi riprodotti di seguito senza usare il telecomando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモコン操作なしでこの回数連続再生すると、次のエピソードの前に確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "리모컨 조작 없이 이 횟수만큼 연속 재생되면 다음 에피소드 전에 물어봐요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyta przed następnym odcinkiem, gdy tyle odcinków zostanie odtworzonych jeden po drugim bez użycia pilota."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergunta antes do próximo episódio quando esta quantidade tiver sido reproduzida seguida sem usar o controle."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若连续播放这么多集且期间未使用遥控器，将在下一集前询问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連續播放這麼多集且未使用遙控器後，會在下一集前詢問。"
          }
        }
      }
    },
