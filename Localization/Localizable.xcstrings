    },
    "If you run the server, Crucible Pro lets you approve, decline and retry everyone's requests from your phone or the couch." : {
      "comment" : "Seerr benefit detail: managing requests",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du kører serveren, kan du med Crucible Pro godkende, afvise og prøve igen alles anmodninger fra din telefon eller fra sofaen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betreibst du den Server, kannst du mit Crucible Pro die Anfragen aller genehmigen, ablehnen und erneut versuchen, vom Handy oder vom Sofa aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si administras el servidor, Crucible Pro te permite aprobar, rechazar y reintentar las solicitudes de todos desde el móvil o desde el sofá."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos ylläpidät palvelinta, Crucible Pron avulla voit hyväksyä, hylätä ja yrittää uudelleen kaikki pyynnöt puhelimella tai sohvalta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous gérez le serveur, Crucible Pro vous permet d’approuver, de refuser et de relancer les demandes de tout le monde, depuis votre téléphone ou le canapé."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ef þú rekur þjóninn gerir Crucible Pro þér kleift að samþykkja, hafna og reyna aftur beiðnir allra, úr símanum eða úr sófanum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se gestisci il server, Crucible Pro ti permette di approvare, rifiutare e riprovare le richieste di tutti dal telefono o dal divano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーを運営しているなら、Crucible Pro で全員のリクエストを、スマートフォンからでもソファに座ったままでも、承認・拒否・再試行できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버를 직접 운영한다면 Crucible Pro로 모든 사람의 요청을 휴대폰에서든 소파에서든 승인, 거절, 재시도할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du driver serveren, lar Crucible Pro deg godkjenne, avslå og prøve igjen alles forespørsler, fra mobilen eller fra sofaen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli prowadzisz serwer, Crucible Pro pozwala zatwierdzać, odrzucać i ponawiać prośby wszystkich z telefonu lub z kanapy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você administra o servidor, o Crucible Pro permite aprovar, recusar e tentar de novo as solicitações de todo mundo pelo celular ou do sofá."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du kör servern låter Crucible Pro dig godkänna, avböja och försöka igen med allas begäranden från din telefon eller från soffan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你管理服务器，Crucible Pro 让你在手机上或沙发上批准、拒绝和重试所有人的请求。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您管理伺服器，Crucible Pro 讓您在手機或沙發上，就能核准、拒絕和重試每個人的請求。"
          }
        }
