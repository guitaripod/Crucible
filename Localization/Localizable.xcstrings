          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store からの応答がありませんでした。しばらくしてから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store에서 응답이 없었어요. 잠시 후 다시 시도해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
