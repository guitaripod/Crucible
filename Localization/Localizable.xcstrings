    "Crucible Server isn't answering. Check that the computer with Plex is on and on this network or your tailnet." : {
      "comment" : "Crucible Server error",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible Server svarer ikke. Tjek, at computeren med Plex er tændt, og at den er på dette netværk eller i dit tailnet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible Server antwortet nicht. Prüfe, ob der Computer mit Plex eingeschaltet ist und sich im selben Netzwerk oder in deinem Tailnet befindet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible Server no responde. Comprueba que el ordenador con Plex esté encendido y en esta red o en tu tailnet."
