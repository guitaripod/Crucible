    "The app is the real thing: playback, downloads, search and Statistics work just as they do with your own server." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen er den rigtige version: afspilning, downloads, søgning og statistik fungerer præcis som med din egen server."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App ist die echte Version: Wiedergabe, Downloads, Suche und Statistiken funktionieren genauso wie mit deinem eigenen Server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app es la versión completa: la reproducción, las descargas, la búsqueda y las estadísticas funcionan igual que con tu propio servidor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä on oikea sovellus: toisto, lataukset, haku ja tilastot toimivat aivan kuten omalla palvelimellasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app est complète : la lecture, les téléchargements, la recherche et les statistiques fonctionnent comme avec votre propre serveur."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appið er alvöru: spilun, niðurhal, leit og tölfræði virka alveg eins og á þínum eigin þjóni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È l'app vera: riproduzione, download, ricerca e statistiche funzionano esattamente come con il tuo server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本物のアプリです。再生、ダウンロード、検索、統計は、お使いのサーバーと同じように動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱은 실제 앱이에요. 재생, 다운로드, 검색, 통계가 내 서버에서와 똑같이 작동해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen er den ekte versjonen: avspilling, nedlastinger, søk og statistikk fungerer akkurat som med din egen server."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To prawdziwa aplikacja: odtwarzanie, pobieranie, wyszukiwanie i statystyki działają tak samo jak z własnym serwerem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app é completo: reprodução, downloads, busca e estatísticas funcionam como com o seu próprio servidor."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen är den riktiga varan: uppspelning, hämtningar, sökning och statistik fungerar precis som med din egen server."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这就是完整应用：播放、下载、搜索和统计的使用方式与你自己的服务器完全相同。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是完整版本：播放、下載、搜尋與統計資料的運作方式，與使用您自己的伺服器時完全相同。"
          }
        }
      }
    },
