    "Your %lld-day free trial starts today. After it ends, your Apple Account is charged %@ per year." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din gratis prøveperiode på %lld dage starter i dag. Når den er slut, opkræves din Apple-konto %@ om året."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine %lld-tägige kostenlose Testphase beginnt heute. Danach wird dein Apple-Account %@ pro Jahr berechnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu prueba gratuita de %lld días empieza hoy. Al terminar, se cobrará %@ al año en tu cuenta de Apple."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmainen %lld päivän kokeilu alkaa tänään. Sen päätyttyä Apple-tililtäsi veloitetaan %@ vuodessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre essai gratuit de %lld jours commence aujourd’hui. À son terme, votre compte Apple sera débité de %@ par an."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ókeypis prufutími þinn í %lld daga hefst í dag. Þegar hann lýkur verður Apple-aðgangurinn þinn rukkaður um %@ á ári."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua prova gratuita di %lld giorni inizia oggi. Al termine, al tuo Account Apple verrà addebitato %@ all'anno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 日間の無料トライアルが今日から始まります。終了後、Apple アカウントに年額 %@ が請求されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld일 무료 체험이 오늘 시작돼요. 체험이 끝나면 Apple 계정으로 연 %@ 요금이 청구돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din %lld-dagers gratis prøveperiode starter i dag. Etter at den er over, belastes Apple-kontoen din med %@ per år."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój %lld-dniowy bezpłatny okres próbny zaczyna się dziś. Po jego zakończeniu z Konta Apple pobierana będzie opłata %@ rocznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu teste grátis de %lld dias começa hoje. Depois que terminar, sua Conta Apple será cobrada %@ por ano."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din %lld-dagars gratis provperiod börjar idag. Efter den debiteras ditt Apple-konto %@ per år."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 %lld 天免费试用从今天开始。试用结束后，你的 Apple 账户将每年被扣费 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的 %lld 天免費試用從今天開始。試用結束後，將以您的 Apple 帳號每年收取 %@。"
          }
