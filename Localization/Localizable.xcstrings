    "Follow each request from requested to approved to downloading, with how far along it is." : {
      "comment" : "Seerr benefit detail: request progress",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følg hver anmodning fra anmodet over godkendt til hentning, og se, hvor langt den er nået."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfolge jede Anfrage vom Stellen über die Freigabe bis zum Download und sieh, wie weit sie ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue cada solicitud desde que se pide hasta que se aprueba y se descarga, con su avance en cada paso."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuraa jokaista pyyntöä pyydetystä hyväksyttyyn ja lataukseen, ja näe kuinka pitkällä se on."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez chaque demande, de l’envoi à l’approbation puis au téléchargement, et voyez où elle en est."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fylgstu með hverri beiðni, frá því hún er send og þar til hún er samþykkt og sótt, og sjáðu hversu langt hún er komin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segui ogni richiesta, dall'invio all'approvazione fino al download, con lo stato di avanzamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「リクエスト済み」「承認済み」「ダウンロード中」と進んでいく流れを、どこまで進んだかとともに追えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청, 승인, 다운로드 중으로 이어지는 각 요청의 진행 상황을 따라가며 볼 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følg hver forespørsel fra forespurt til godkjent og lastet ned, og se hvor langt den er kommet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Śledź każdą prośbę od zgłoszenia, przez zatwierdzenie, po pobieranie, wraz z tym, na jakim etapie jest."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja cada solicitação passar de solicitada a aprovada e baixando, com o andamento de cada uma."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Följ varje begäran från begärd till godkänd och hämtad, med hur långt den har kommit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追踪每个请求从已请求、已批准到下载中的全过程，并显示进度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個請求從「已請求」、「已核准」到「下載中」，進度一目了然。"
