        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þessi pörunarkóði er rangur eða útrunninn. Keyrðu crucible-server pair til að fá nýjan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
