        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile dla osób, z którymi mieszkasz, konfiguruje się w Plexie, w sekcji Plex Home."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
