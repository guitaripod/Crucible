    "Thank you for supporting Crucible. Unlimited downloads, full Statistics and the Year in Review poster are unlocked." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danke, dass du Crucible unterstützt. Unbegrenzte Downloads, vollständige Statistiken und das Jahresrückblick-Poster sind freigeschaltet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gracias por apoyar Crucible. Se han desbloqueado las descargas ilimitadas, las estadísticas completas y el póster de Tu año en revisión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merci de soutenir Crucible. Les téléchargements illimités, les statistiques complètes et l’affiche du bilan annuel sont débloqués."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grazie per aver sostenuto Crucible. Download illimitati, statistiche complete e il poster Anno in rassegna sono sbloccati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible をご支援いただきありがとうございます。無制限のダウンロード、統計の全機能、「年間振り返り」ポスターが利用できるようになりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible을 지원해 주셔서 감사해요. 무제한 다운로드, 전체 통계, 올해의 기록 포스터가 잠금 해제됐어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dziękujemy za wsparcie Crucible. Odblokowano nieograniczone pobieranie, pełne statystyki i plakat Rok w przeglądzie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrigado por apoiar o Crucible. Downloads ilimitados, estatísticas completas e o pôster Retrospectiva do Ano estão desbloqueados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感谢你支持 Crucible。无限下载、完整统计和年度回顾海报已解锁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感謝您支持 Crucible。無限下載、完整統計資料與年度回顧海報已解鎖。"
          }
        }
      }
    },
    "The App Store did not answer. Try again in a moment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der App Store hat nicht geantwortet. Versuche es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La App Store no ha respondido. Inténtalo de nuevo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’App Store n’a pas répondu. Réessayez dans un moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'App Store non ha risposto. Riprova tra poco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store からの応答がありませんでした。しばらくしてから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store에서 응답이 없었어요. 잠시 후 다시 시도해 주세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store nie odpowiedział. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A App Store não respondeu. Tente novamente em instantes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store 没有响应。请稍后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store 沒有回應。請稍後再試一次。"
          }
        }
      }
    },
    "The App Store did not answer. Try again in a moment. You have not been charged unless the App Store says otherwise." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der App Store hat nicht geantwortet. Versuche es gleich noch einmal. Dir wurde nichts berechnet, sofern der App Store nichts anderes angibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La App Store no ha respondido. Inténtalo de nuevo en un momento. No se te ha cobrado nada, salvo que la App Store indique lo contrario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’App Store n’a pas répondu. Réessayez dans un moment. Aucun montant ne vous a été débité, sauf indication contraire de l’App Store."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'App Store non ha risposto. Riprova tra poco. Non ti è stato addebitato nulla, salvo diversa indicazione dell'App Store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store からの応答がありませんでした。しばらくしてから、もう一度お試しください。App Store から別途案内がない限り、料金は請求されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store에서 응답이 없었어요. 잠시 후 다시 시도해 주세요. App Store에서 다르게 안내하지 않는 한 요금이 청구되지 않았어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store nie odpowiedział. Spróbuj ponownie za chwilę. Nie pobrano opłaty, chyba że App Store stwierdzi inaczej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A App Store não respondeu. Tente novamente em instantes. Você não foi cobrado, a menos que a App Store informe o contrário."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store 没有响应。请稍后重试。除非 App Store 另有说明，否则你不会被扣费。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store 沒有回應。請稍後再試一次。除非 App Store 另有說明，否則您不會被收費。"
          }
        }
      }
    },
    "The app is the real thing: playback, downloads, search and Statistics work just as they do with your own server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App ist die echte Version: Wiedergabe, Downloads, Suche und Statistiken funktionieren genauso wie mit deinem eigenen Server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app es la versión completa: la reproducción, las descargas, la búsqueda y las estadísticas funcionan igual que con tu propio servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app est complète : la lecture, les téléchargements, la recherche et les statistiques fonctionnent comme avec votre propre serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È l'app vera: riproduzione, download, ricerca e statistiche funzionano esattamente come con il tuo server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本物のアプリです。再生、ダウンロード、検索、統計は、お使いのサーバーと同じように動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱은 실제 앱이에요. 재생, 다운로드, 검색, 통계가 내 서버에서와 똑같이 작동해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To prawdziwa aplikacja: odtwarzanie, pobieranie, wyszukiwanie i statystyki działają tak samo jak z własnym serwerem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app é completo: reprodução, downloads, busca e estatísticas funcionam como com o seu próprio servidor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这就是完整应用：播放、下载、搜索和统计的使用方式与你自己的服务器完全相同。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是完整版本：播放、下載、搜尋與統計資料的運作方式，與使用您自己的伺服器時完全相同。"
          }
        }
      }
    },
    "The connection dropped. Try again." : {
      "localizations" : {
