          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于服务器绘制到画面中的字幕，也适用于播放器绘制的字幕。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "適用於伺服器燒進畫面的字幕，以及播放器繪製的字幕。"
