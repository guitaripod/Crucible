    "Download whole seasons, queue as many titles as you like and keep the next episodes ready." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hent hele sæsoner, sæt så mange titler i kø, du vil, og hold de næste afsnit klar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade ganze Staffeln herunter, reihe beliebig viele Titel ein und halte die nächsten Folgen bereit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga temporadas completas, pon en cola todos los títulos que quieras y ten listos los próximos episodios."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lataa kokonaisia kausia, jonota niin monta nimikettä kuin haluat ja pidä seuraavat jaksot valmiina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téléchargez des saisons entières, ajoutez autant de titres que vous voulez à la file et gardez les épisodes suivants prêts."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæktu heilar þáttaraðir, settu eins marga titla í röð og þú vilt og hafðu næstu þætti tilbúna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica intere stagioni, metti in coda quanti titoli vuoi e tieni pronti i prossimi episodi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シーズン全体をダウンロードしたり、好きなだけタイトルをキューに入れたり、次のエピソードを準備しておいたりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시즌 전체를 다운로드하고, 원하는 만큼 제목을 대기열에 넣고, 다음 에피소드를 미리 준비해 두세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Last ned hele sesonger, legg så mange titler du vil i køen og hold de neste episodene klare."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobieraj całe sezony, układaj w kolejce dowolną liczbę tytułów i miej gotowe kolejne odcinki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixe temporadas inteiras, coloque quantos títulos quiser na fila e mantenha os próximos episódios prontos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hämta hela säsonger, köa så många titlar du vill och håll nästa avsnitt redo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载整季，将任意数量的标题加入队列，并保留接下来的几集随时可看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下載整季內容，可排入任意數量的作品，並預先準備接下來的集數。"
          }
        }
      }
    },
