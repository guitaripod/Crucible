    "The App Store did not answer. Try again in a moment." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store svarede ikke. Prøv igen om lidt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der App Store hat nicht geantwortet. Versuche es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La App Store no ha respondido. Inténtalo de nuevo en un momento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store ei vastannut. Yritä hetken kuluttua uudelleen."
