        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa TrueNASissa Apps, valitse Discover Apps, hae Seerr ja asenna se. Pidä sen web-portti 5055, sillä Crucible etsii Seerriä juuri sieltä."
          }
        },
        "fr" : {
