          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store nie odpowiedział. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A App Store não respondeu. Tente novamente em instantes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store svarade inte. Försök igen om en stund."
