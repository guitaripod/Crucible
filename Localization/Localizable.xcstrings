    "%@ isn't answering. Check the model server on the computer with Plex." : {
      "comment" : "Crucible Server status when its model does not answer",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ svarer ikke. Tjek modelserveren på computeren med Plex."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ antwortet nicht. Prüfe den Modellserver auf dem Computer mit Plex."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no responde. Revisa el servidor de modelos del ordenador con Plex."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ei vastaa. Tarkista mallipalvelin tietokoneelta, jolla Plex-palvelin on."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne répond pas. Vérifiez le serveur de modèles sur l’ordinateur avec Plex."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ svarar ekki. Athugaðu líkanaþjóninn á tölvunni sem keyrir Plex."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non risponde. Controlla il server dei modelli sul computer con Plex."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ が応答しません。Plex のあるコンピューターのモデルサーバーを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 응답하지 않아요. Plex가 있는 컴퓨터의 모델 서버를 확인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ svarer ikke. Sjekk modellserveren på datamaskinen med Plex."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie odpowiada. Sprawdź serwer modeli na komputerze z Plexem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não está respondendo. Verifique o servidor de modelos no computador com Plex."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ svarar inte. Kontrollera modellservern på datorn med Plex."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有响应。请检查装有 Plex 的电脑上的模型服务。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 沒有回應。請檢查裝有 Plex 的電腦上的模型伺服器。"
          }
        }
      }
    },
    "%@ isn't named like any machine on your tailnet. Add it by address." : {
      "localizations" : {
        "da" : {
