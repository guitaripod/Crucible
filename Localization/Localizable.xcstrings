    "Asks before the next episode once this many have played in a row without the remote." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragt vor der nächsten Folge nach, wenn so viele Folgen ohne Fernbedienung hintereinander gespielt wurden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
