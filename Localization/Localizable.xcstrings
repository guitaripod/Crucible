    "%@. Tap to rate them all in one place." : {
      "comment" : "Body of the one reminder that gathers several titles to rate, e.g. Dune, Severance and 2 more. Tap to rate them all in one place.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Tryk for at bedømme dem alle samlet ét sted."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Tippe, um alles an einem Ort zu bewerten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Toca para valorarlos todos en un mismo lugar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Napauta, niin arvostelet ne kaikki yhdessä paikassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Touchez pour tout noter au même endroit."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Ýttu til að gefa þeim öllum einkunn á einum stað."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Tocca per valutarli tutti in un unico posto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。タップしてまとめて評価できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. 탭하여 한곳에서 모두 평가하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Trykk for å vurdere dem alle på ett sted."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Stuknij, aby ocenić wszystko w jednym miejscu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Toque para avaliar tudo em um só lugar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Tryck för att betygsätta alla på ett ställe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。轻点即可在一处为它们全部评分。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。點一下即可在同一處為它們全部評分。"
          }
        }
      }
    },
