    "Save it to watch offline, with progress on the Lock Screen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichere es zum Offline-Schauen, mit Fortschritt auf dem Sperrbildschirm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guárdalo para verlo sin conexión, con el progreso en la pantalla de bloqueo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez-le pour le regarder hors ligne, avec la progression sur l’écran verrouillé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvalo per guardarlo offline, con l'avanzamento nella schermata di blocco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存するとオフラインで視聴でき、ロック画面に進行状況が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장해서 오프라인에서 보세요. 잠금 화면에서 진행 상황을 볼 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
