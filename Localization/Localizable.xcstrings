    "Marking a title unwatched also removes its plays from your Trakt history." : {
      "comment" : "Explanation of the Unwatched Removes Plays setting",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du markerer en titel som ikke set, fjernes afspilningerne også fra din Trakt-historik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du einen Titel als ungesehen markierst, werden seine Wiedergaben auch aus deinem Trakt-Verlauf entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marcar un título como no visto también elimina sus reproducciones de tu historial de Trakt."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun merkitset nimikkeen katsomattomaksi, myös sen toistot poistetaan Traktin historiasta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marquer un titre comme non vu supprime aussi ses lectures de votre historique Trakt."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Að merkja titil sem óséðan fjarlægir einnig áhorf hans úr Trakt-ferlinum þínum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrassegnare un titolo come non visto rimuove anche le sue riproduzioni dalla tua cronologia Trakt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイトルを未視聴に戻すと、Trakt の視聴履歴からその再生記録も削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제목을 시청 안 함으로 표시하면 Trakt 시청 기록에서 해당 재생도 함께 삭제됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du merker en tittel som usett, fjernes avspillingene også fra Trakt-historikken din."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznaczenie tytułu jako nieobejrzany usuwa też jego odtworzenia z historii Trakt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marcar um título como não assistido também remove as reproduções dele do seu histórico no Trakt."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du markerar en titel som osedd tas även dess uppspelningar bort från din Trakt-historik."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将作品标记为未观看时，也会从 Trakt 历史记录中移除其播放记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將作品標示為未看時，也會從 Trakt 歷史紀錄中移除其播放紀錄。"
          }
        }
      }
    },
