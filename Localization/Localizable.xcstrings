      }
    },
    "Crucible signs out of Seerr on this device. Your requests stay in Seerr." : {
      "comment" : "Confirmation message for disconnecting Seerr",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible logger dig af Seerr på denne enhed. Dine anmodninger bliver i Seerr."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible meldet dich auf diesem Gerät von Seerr ab. Deine Anfragen bleiben in Seerr erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible cerrará la sesión de Seerr en este dispositivo. Tus solicitudes seguirán en Seerr."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible kirjautuu ulos Seerrista tältä laitteelta. Pyyntösi pysyvät Seerrissä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible se déconnecte de Seerr sur cet appareil. Vos demandes restent dans Seerr."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
