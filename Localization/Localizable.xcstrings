    "None of the server's known addresses answered. Check that it's online and reachable from this network." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen af serverens kendte adresser svarede. Kontroller, at den er online og kan nås fra dette netværk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine der bekannten Adressen des Servers hat geantwortet. Prüfe, ob er online und aus diesem Netzwerk erreichbar ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna de las direcciones conocidas del servidor ha respondido. Comprueba que esté en línea y sea accesible desde esta red."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikään palvelimen tunnetuista osoitteista ei vastannut. Tarkista, että palvelin on päällä ja tavoitettavissa tästä verkosta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune des adresses connues du serveur n’a répondu. Vérifiez qu’il est en ligne et accessible depuis ce réseau."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engin af þekktum vistföngum þjónsins svaraði. Athugaðu hvort hann sé í gangi og aðgengilegur frá þessu neti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno degli indirizzi noti del server ha risposto. Controlla che sia online e raggiungibile da questa rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーの既知のアドレスからの応答がありませんでした。オンラインで、このネットワークから到達できるか確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버의 알려진 주소 중 응답한 곳이 없어요. 서버가 켜져 있고 이 네트워크에서 접근 가능한지 확인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen av serverens kjente adresser svarte. Sjekk at den er på nett og kan nås fra dette nettverket."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żaden znany adres serwera nie odpowiedział. Sprawdź, czy jest online i dostępny z tej sieci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum dos endereços conhecidos do servidor respondeu. Verifique se ele está online e acessível nesta rede."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen av serverns kända adresser svarade. Kontrollera att den är online och går att nå från det här nätverket."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器的已知地址均无响应。请检查它是否在线，并能否从当前网络访问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器已知的所有位址都沒有回應。請確認伺服器已上線，且可從此網路連線。"
          }
        }
      }
    },
