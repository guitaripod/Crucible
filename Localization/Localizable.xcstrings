    "A download is removed once you have watched it to the end." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Download wird entfernt, sobald du ihn bis zum Ende gesehen hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una descarga se elimina cuando la has visto hasta el final."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un téléchargement est retiré une fois que vous l’avez regardé jusqu’au bout."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un download viene rimosso quando lo hai guardato fino alla fine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードは最後まで視聴すると削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드한 항목을 끝까지 시청하면 다운로드가 삭제돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobranie zostanie usunięte po obejrzeniu do końca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um download é removido depois que você assistir até o final."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看完后将移除该下载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看完後會自動移除下載項目。"
          }
        }
      }
    },
