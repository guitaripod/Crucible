    "%@ isn't named like any machine on your tailnet. Add it by address." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat keinen Namen wie ein Gerät in deinem Tailnet. Füge es per Adresse hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún equipo de tu tailnet se llama %@. Añádelo por dirección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne correspond à aucune machine de votre tailnet. Ajoutez-la par adresse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non corrisponde al nome di nessuna macchina della tua tailnet. Aggiungilo tramite indirizzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は tailnet 上のどのマシン名とも一致しません。アドレスで追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ 이름의 기기가 tailnet에 없어요. 주소로 추가하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nazwa %@ nie pasuje do żadnego urządzenia w Twojej sieci tailnet. Dodaj je przez adres."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não tem nome igual ao de nenhum dispositivo da sua tailnet. Adicione pelo endereço."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 与 tailnet 中的任何设备名称都不匹配。请按地址添加。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不是您 tailnet 中任何裝置的名稱，請改用位址新增。"
          }
        }
      }
    },
