        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filmy i seriale, które skończysz, czekają tutaj, aż je ocenisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filmes e séries que você terminar ficam aqui até você avaliá-los."
