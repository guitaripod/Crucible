    "Drag a row by its handle to move it. Continue Watching's newest title stays the big card at the top of Home." : {
      "comment" : "Footer of the Home rows settings",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe eine Reihe an ihrem Griff, um sie zu verschieben. Der neueste Titel von Weiterschauen bleibt die große Karte oben auf Start."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra una fila por su asa para moverla. El título más reciente de Seguir viendo se queda como tarjeta grande en la parte superior de Inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser une rangée par sa poignée pour la déplacer. Le titre le plus récent de « Reprendre la lecture » reste la grande carte en haut de l’accueil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina una riga dalla maniglia per spostarla. Il titolo più recente di Continua a guardare resta la scheda grande in cima alla Home."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行のハンドルをドラッグして並べ替えます。「続きを見る」の最新のタイトルは、ホームの上部に大きなカードとして表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손잡이를 끌어서 행을 옮길 수 있어요. 이어보기의 가장 최근 제목은 홈 맨 위에 큰 카드로 계속 표시돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij wiersz za uchwyt, aby go przesunąć. Najnowszy tytuł z Kontynuuj oglądanie zostaje dużą kartą na górze ekranu Start."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste uma linha pela alça para movê-la. O título mais recente de Continuar assistindo continua como cartão grande no topo do Início."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动行的把手即可移动。“继续观看”中最新的标题会始终作为大卡片显示在首页顶部。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖曳列的把手即可調整順序。「繼續觀看」中最新的作品會保留在首頁頂端的大卡片。"
          }
        }
      }
    },
