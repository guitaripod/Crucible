    "Applies to subtitles the server draws into the picture and to the ones the player draws." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gælder for undertekster, som serveren brænder ind i billedet, og for dem, som afspilleren tegner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
