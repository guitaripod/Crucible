            "value" : "Schritt für Schritt, mit den Befehlen für deinen Server"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paso a paso, con los comandos para tu servidor"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Askel askeleelta, palvelimesi komennoilla"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Étape par étape, avec les commandes pour votre serveur"
