          "stringUnit" : {
            "state" : "translated",
            "value" : "モバイルデータ通信で使われ、映画でデータ容量を使い切らないようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모바일 데이터에서 영화가 요금제 데이터를 다 쓰지 않도록 해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brukes på mobildata, så en film ikke bruker opp datapakken din."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używane w transmisji komórkowej, aby film nie zużył Twojego pakietu danych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado em dados móveis, para que um filme não consuma seu plano."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Används på mobildata så att en film inte förbrukar ditt datapaket."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于移动数据，避免电影耗尽你的套餐流量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用行動數據時套用，避免電影耗盡您的方案流量。"
          }
        }
      }
    },
    "Used when the server is reached over the internet or Plex Relay, where upload speed is often the limit." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruges, når serveren nås via internettet eller Plex Relay, hvor uploadhastigheden ofte er flaskehalsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird genutzt, wenn der Server über das Internet oder Plex Relay erreicht wird, wo oft die Upload-Geschwindigkeit der Engpass ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa cuando se llega al servidor por internet o por el Relay de Plex, donde a menudo el límite es la velocidad de subida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytetään, kun palvelimeen yhdistetään internetin tai Plex Relayn kautta. Silloin lähetysnopeus on usein rajoittava tekijä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé lorsque le serveur est joint par Internet ou par le relais Plex, où la vitesse d’envoi est souvent le facteur limitant."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notað þegar þjónninn er tengdur um internetið eða Plex Relay, þar sem upphleðsluhraðinn er oft flöskuhálsinn."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usato quando si raggiunge il server via internet o Relay Plex, dove spesso il limite è la velocità di upload."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インターネットまたは Plex リレー経由でサーバーに接続する場合に使われます。この場合は多くの場合、アップロード速度が上限になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버에 인터넷이나 Plex 릴레이로 연결할 때 사용해요. 이런 경우에는 업로드 속도가 제한 요인인 경우가 많아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brukes når serveren nås via internett eller Plex Relay, der opplastingshastigheten ofte er begrensningen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używane, gdy do serwera łączysz się przez internet lub Przekaźnik Plex, gdzie ograniczeniem bywa prędkość wysyłania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado quando o servidor é acessado pela internet ou pelo Relay do Plex, onde a velocidade de upload costuma ser o limite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Används när servern nås via internet eller Plex Relay, där uppladdningshastigheten ofta är flaskhalsen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当通过互联网或 Plex 中继连接服务器时使用，此时上传速度通常是瓶颈。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過網際網路或 Plex 中繼連線至伺服器時使用，這時上傳速度通常是限制。"
          }
        }
      }
    },
    "Uses this connection until the network changes" : {
      "comment" : "VoiceOver hint of a server connection row",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruger denne forbindelse, indtil netværket ændres"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet diese Verbindung bis zur nächsten Netzwerkänderung"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa esta conexión hasta que cambie la red"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käyttää tätä yhteyttä, kunnes verkko vaihtuu"
