    "Previously On stops until you pair again." : {
      "comment" : "Confirmation message for unpairing Crucible Server",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resumé holder op, indtil du parrer igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Was bisher geschah“ pausiert, bis du dich erneut koppelst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Anteriormente» se detiene hasta que vuelvas a vincular."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Aiemmin” pysähtyy, kunnes muodostat parin uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Précédemment » sera interrompu jusqu’à un nouvel appairage."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Það sem gerðist áður“ stöðvast þar til þú parar aftur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Nelle puntate precedenti» si interrompe finché non effettui di nuovo l’abbinamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再度ペアリングするまで「前回までのあらすじ」は停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다시 페어링할 때까지 '지난 이야기'가 중지돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Tidligere i serien» stanser til du kobler sammen på nytt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„W poprzednich odcinkach” wstrzymane do ponownego sparowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Anteriormente fica desativado até você parear novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Tidigare i” pausas tills du kopplar ihop igen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新配对之前，「前情提要」将停止工作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新配對前，「前情提要」將停止運作。"
          }
        }
      }
    },
