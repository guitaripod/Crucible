    "Skip Outro decides what the credits do: show the Up Next card, start the next episode automatically, or stay out of the way." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spring outro over bestemmer, hvad der sker under rulleteksten: vis kortet »Næste«, start næste afsnit automatisk, eller hold dig ude af vejen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outro überspringen legt fest, was mit dem Abspann passiert: Karte „Als Nächstes“ anzeigen, die nächste Folge automatisch starten oder sich zurückhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saltar final decide qué ocurre con los créditos: mostrar la tarjeta A continuación, empezar el siguiente episodio automáticamente o no intervenir."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohita outro määrittää, mitä lopputeksteille tehdään: näytetään Seuraavana-kortti, aloitetaan seuraava jakso automaattisesti tai jätetään lopputekstit rauhaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passer la fin détermine ce que fait le générique : afficher la carte À suivre, lancer automatiquement l’épisode suivant ou ne rien faire."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Sleppa lokakafla“ ákvarðar hvað gerist í lokaeiningunum: sýna spjaldið Næst, byrja næsta þátt sjálfkrafa eða halda sig til hliðar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta titoli di coda decide cosa fare con i titoli di coda: mostrare la scheda Prossimo, avviare automaticamente l'episodio successivo oppure non intervenire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エンディングのスキップでは、エンドクレジットの間の動作を選べます。次に見るカードを表示する、次のエピソードを自動で開始する、または何もしないから選択できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "엔딩 건너뛰기는 엔딩 크레딧 때 동작을 정해요. 다음 재생 카드를 보여주거나, 다음 에피소드를 자동으로 시작하거나, 아무것도 하지 않을 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Hopp over outro» bestemmer hva sluttekstene gjør: vise kortet «Neste», starte neste episode automatisk eller holde seg unna."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomijanie outra decyduje, co zrobią napisy końcowe: pokazać kartę Następne, automatycznie odtworzyć kolejny odcinek albo nie przeszkadzać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pular final define o que acontece nos créditos: mostrar o cartão A seguir, iniciar o próximo episódio automaticamente ou não interferir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoppa över outro avgör vad som händer under eftertexterna: visa kortet Nästa, starta nästa avsnitt automatiskt eller hålla sig utanför."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“跳过片尾”决定片尾时的行为：显示“接下来播放”卡片、自动开始下一集，或保持不干预。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跳過片尾決定片尾時的行為：顯示「接著播放」卡片、自動播放下一集，或不做任何動作。"
          }
        }
      }
    },
