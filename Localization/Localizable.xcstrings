    "%@ The demo, its viewing history and your tour progress are removed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Die Demo, ihr Wiedergabeverlauf und dein Fortschritt in der Tour werden entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Se eliminarán la demo, su historial de reproducción y tu progreso en el recorrido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ La démo, son historique de lecture et votre progression dans la visite seront supprimés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ La demo, la sua cronologia di visione e i progressi del tour vengono rimossi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ デモ、その視聴履歴、ツアーの進行状況が削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 데모, 시청 기록, 둘러보기 진행 상황이 삭제돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Wersja demonstracyjna, jej historia oglądania i postęp wycieczki zostaną usunięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ A demonstração, o histórico de exibição e o progresso do tour serão removidos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 演示内容、观看记录和导览进度都将被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 示範內容、觀看紀錄與導覽進度將被移除。"
          }
        }
      }
    },
    "%@ The subscription renews automatically unless you cancel at least 24 hours before the end of the current period. Manage or cancel it any time in your Apple Account settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Das Abo verlängert sich automatisch, sofern du es nicht mindestens 24 Stunden vor Ende des laufenden Zeitraums kündigst. Du kannst es jederzeit in den Einstellungen deines Apple-Accounts verwalten oder kündigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ La suscripción se renueva automáticamente salvo que la canceles al menos 24 horas antes del final del periodo actual. Puedes gestionarla o cancelarla en cualquier momento en los ajustes de tu cuenta de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ L’abonnement se renouvelle automatiquement, sauf si vous l’annulez au moins 24 heures avant la fin de la période en cours. Vous pouvez le gérer ou l’annuler à tout moment dans les réglages de votre compte Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ L'abbonamento si rinnova automaticamente, a meno che non lo annulli almeno 24 ore prima della fine del periodo in corso. Puoi gestirlo o annullarlo in qualsiasi momento nelle impostazioni del tuo Account Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 現在の期間が終了する少なくとも 24 時間前までに解約しない限り、サブスクリプションは自動的に更新されます。解約や管理はいつでも Apple アカウントの設定から行えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 현재 기간이 끝나기 24시간 전까지 해지하지 않으면 구독이 자동으로 갱신돼요. 언제든 Apple 계정 설정에서 관리하거나 해지할 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Subskrypcja odnawia się automatycznie, chyba że anulujesz ją co najmniej 24 godziny przed końcem bieżącego okresu. Zarządzaj subskrypcją lub anuluj ją w dowolnym momencie w ustawieniach Konta Apple."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ A assinatura é renovada automaticamente, a menos que você a cancele pelo menos 24 horas antes do fim do período atual. Gerencie ou cancele a qualquer momento nos ajustes da sua Conta Apple."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 除非你在当前周期结束前至少 24 小时取消，否则订阅将自动续订。你可以随时在 Apple 账户设置中管理或取消订阅。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 除非您在目前週期結束前至少 24 小時取消，否則訂閱會自動續訂。您可以隨時在 Apple 帳號設定中管理或取消。"
          }
        }
      }
    },
