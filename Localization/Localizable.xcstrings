    "Skip Back and Skip Ahead set the skip buttons on the Lock Screen, in Control Center and on headphones." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zurückspringen und Vorspringen legen die Sprungtasten auf dem Sperrbildschirm, im Kontrollzentrum und auf Kopfhörern fest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saltar atrás y Saltar adelante configuran los botones de salto de la pantalla de bloqueo, del Centro de control y de los auriculares."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reculer et Avancer définissent les boutons de saut de l’écran verrouillé, du Centre de contrôle et des écouteurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta indietro e Salta avanti impostano i pulsanti di salto nella schermata di blocco, in Centro di controllo e sulle cuffie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「後ろへスキップ」と「先へスキップ」は、ロック画面、コントロールセンター、ヘッドフォンのスキップボタンに設定されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "뒤로 건너뛰기와 앞으로 건너뛰기는 잠금 화면, 제어 센터, 헤드폰의 건너뛰기 버튼을 설정해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeskocz do tyłu i do przodu ustawiają przyciski pomijania na ekranie blokady, w Centrum sterowania i na słuchawkach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pular para trás e Pular para frente definem os botões de pular na Tela de Bloqueio, na Central de Controle e nos fones de ouvido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“后退跳过”和“快进跳过”用于设置锁定屏幕、控制中心和耳机上的跳过按钮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「向後跳過」與「向前跳過」會設定鎖定畫面、控制中心與耳機上的跳過按鈕。"
          }
        }
      }
    },
