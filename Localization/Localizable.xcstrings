    "These settings live on your server, so they apply to everyone who watches this show." : {
      "comment" : "Note on the Show Settings screen",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse indstillinger ligger på din server, så de gælder for alle, der ser denne serie."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einstellungen liegen auf deinem Server und gelten daher für alle, die diese Serie schauen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos ajustes se guardan en tu servidor, así que se aplican a todas las personas que ven esta serie."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nämä asetukset ovat palvelimellasi, joten ne koskevat kaikkia, jotka katsovat tätä sarjaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces réglages sont enregistrés sur votre serveur et s’appliquent donc à tous ceux qui regardent cette série."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þessar stillingar eru geymdar á þjóninum þínum, svo þær gilda fyrir alla sem horfa á þessa sjónvarpsþáttaröð."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste impostazioni sono salvate sul tuo server, quindi valgono per tutti quelli che guardano questa serie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの設定はサーバーに保存されるため、この番組を見るすべての人に適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 설정은 서버에 저장되므로, 이 시리즈를 보는 모든 사람에게 적용돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse innstillingene ligger på serveren din, så de gjelder for alle som ser denne serien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te ustawienia są zapisane na serwerze, więc obowiązują wszystkich, którzy oglądają ten serial."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas configurações ficam no seu servidor, então valem para todos que assistem a esta série."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inställningarna sparas på din server, så de gäller alla som tittar på den här serien."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些设置保存在你的服务器上，因此会对所有观看此剧集的人生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些設定保存在您的伺服器上，因此會套用到所有觀看此影集的人。"
