    "From your watchlist, now on your server. Tap to watch." : {
      "comment" : "Body of the notification for a watchlisted title that arrived on the server",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von deiner Watchlist, jetzt auf deinem Server. Tippe, um es anzusehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tu lista para ver, ya en tu servidor. Toca para verlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un titre de votre liste de suivi est maintenant sur votre serveur. Touchez pour le regarder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dalla tua Watchlist, ora sul tuo server. Tocca per guardarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウォッチリストの作品がサーバーに追加されました。タップして視聴します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "관심 목록에 있던 작품이 서버에 추가됐어요. 탭해서 보세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z Twojej listy do obejrzenia, jest już na serwerze. Stuknij, aby obejrzeć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da sua lista para assistir, agora no seu servidor. Toque para assistir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的待看列表中的内容已上线。点按观看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的待看清單中的作品已在伺服器上。輕點即可觀看。"
          }
        }
      }
    },
