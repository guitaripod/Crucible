    "The server's secure certificate could not be verified. Crucible will look for another route on the next launch — or re-add the server from Settings." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serverens sikkerhedscertifikat kunne ikke bekræftes. Crucible prøver ved næste start at finde en anden forbindelse, eller du kan tilføje serveren igen under Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das sichere Zertifikat des Servers konnte nicht überprüft werden. Crucible sucht beim nächsten Start einen anderen Weg, oder füge den Server in den Einstellungen erneut hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo verificar el certificado seguro del servidor. Crucible buscará otra ruta al abrirse la próxima vez, o puedes volver a añadir el servidor desde Ajustes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelimen suojattua varmennetta ei voitu vahvistaa. Crucible etsii seuraavalla käynnistyksellä toisen yhteysreitin, tai lisää palvelin uudelleen asetuksista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le certificat sécurisé du serveur n’a pas pu être vérifié. Crucible cherchera un autre chemin au prochain lancement, ou vous pouvez ajouter de nouveau le serveur depuis les réglages."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekki var hægt að sannreyna öryggisvottorð þjónsins. Crucible leitar að annarri leið við næstu ræsingu, eða bættu þjóninum aftur við í Stillingum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile verificare il certificato sicuro del server. Crucible cercherà un altro percorso al prossimo avvio, oppure aggiungi di nuovo il server dalle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーのセキュア証明書を検証できませんでした。次回起動時に Crucible が別の経路を探します（または設定からサーバーを追加し直してください）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버의 보안 인증서를 확인할 수 없었어요. Crucible은 다음 실행 때 다른 경로를 찾아요. 설정에서 서버를 다시 추가할 수도 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serverens sikkerhetssertifikat kunne ikke bekreftes. Crucible prøver en annen vei ved neste oppstart – eller legg til serveren på nytt i Innstillinger."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się zweryfikować bezpiecznego certyfikatu serwera. Crucible poszuka innej trasy przy następnym uruchomieniu albo dodaj serwer ponownie w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível verificar o certificado seguro do servidor. O Crucible procurará outra rota na próxima abertura, ou adicione o servidor de novo nos Ajustes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serverns säkra certifikat kunde inte verifieras. Crucible letar efter en annan väg vid nästa start, eller lägg till servern igen i Inställningar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法验证服务器的安全证书。Crucible 将在下次启动时查找其他路线，或在“设置”中重新添加服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法驗證伺服器的安全憑證。Crucible 會在下次啟動時尋找其他路徑，或您也可以在「設定」中重新新增伺服器。"
          }
        }
      }
