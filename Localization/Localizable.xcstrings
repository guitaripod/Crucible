    "Could not connect securely to the server. Crucible will re-check your server's address on the next launch." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke oprette en sikker forbindelse til serveren. Crucible tjekker serverens adresse igen ved næste start."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine sichere Verbindung zum Server möglich. Crucible prüft die Serveradresse beim nächsten Start erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar de forma segura con el servidor. Crucible volverá a comprobar la dirección del servidor al abrirse la próxima vez."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turvallista yhteyttä palvelimeen ei voitu muodostaa. Crucible tarkistaa palvelimen osoitteen uudelleen seuraavalla käynnistyksellä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connexion sécurisée au serveur impossible. Crucible vérifiera de nouveau l’adresse de votre serveur au prochain lancement."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekki tókst að tengjast þjóninum á öruggan hátt. Crucible athugar vistfang þjónsins aftur við næstu ræsingu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile connettersi al server in modo sicuro. Crucible verificherà di nuovo l'indirizzo del server al prossimo avvio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーに安全に接続できませんでした。次回起動時に Crucible がサーバーのアドレスを再確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
