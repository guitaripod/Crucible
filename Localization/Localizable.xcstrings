    "Another computer answered at that address, so Crucible didn't pair with it." : {
      "comment" : "Crucible Server error when the certificate or proof does not match",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En anden computer svarede på den adresse, så Crucible parrede ikke med den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein anderer Computer hat unter dieser Adresse geantwortet, daher hat Crucible sich nicht mit ihm gekoppelt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otro ordenador respondió en esa dirección, así que Crucible no se ha vinculado con él."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toinen tietokone vastasi tässä osoitteessa, joten Crucible ei muodostanut paria sen kanssa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un autre ordinateur a répondu à cette adresse, Crucible ne s’est donc pas appairé avec lui."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önnur tölva svaraði á þessu vistfangi, svo Crucible tengdist henni ekki."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un altro computer ha risposto a quell’indirizzo, quindi Crucible non ha effettuato l’abbinamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのアドレスには別のコンピューターが応答したため、Crucible はペアリングしませんでした。"
