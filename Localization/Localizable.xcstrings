    "Movies and shows you finish wait here until you rate them." : {
      "comment" : "Message shown when Rate What You Watched has no titles left",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filme und Serien, die du beendest, warten hier, bis du sie bewertest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las películas y series que termines esperan aquí hasta que las valores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les films et séries que vous terminez vous attendent ici jusqu’à ce que vous les notiez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I film e le serie che finisci restano qui finché non li valuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "見終えた映画や番組は、評価するまでここで待っています。"
          }
