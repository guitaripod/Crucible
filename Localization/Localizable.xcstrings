    "Add a movie or TV show library to your Plex server to browse it here." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj et film- eller seriebibliotek til din Plex-server for at gennemse det her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge deinem Plex-Server eine Film- oder Serien-Mediathek hinzu, um sie hier zu durchsuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una biblioteca de películas o series a tu servidor de Plex para explorarla aquí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää Plex-palvelimeesi elokuva- tai sarjakirjasto, niin voit selata sitä täällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez une bibliothèque de films ou de séries à votre serveur Plex pour la parcourir ici."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bættu við safni fyrir kvikmyndir eða sjónvarpsþætti á Plex-þjóninum þínum til að skoða það hér."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi una libreria di film o serie TV al tuo server Plex per sfogliarla qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここで閲覧するには、Plex サーバーに映画または番組のライブラリを追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기서 보려면 Plex 서버에 영화나 TV 시리즈 보관함을 추가하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til et film- eller seriebibliotek på Plex-serveren din for å bla gjennom det her."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj bibliotekę filmów lub seriali do swojego serwera Plex, aby przeglądać ją tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione uma biblioteca de filmes ou séries ao seu servidor Plex para navegar por ela aqui."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till ett film- eller seriebibliotek på din Plex-server för att bläddra i det här."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将电影或剧集资料库添加到你的 Plex 服务器，即可在此浏览。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在 Plex 伺服器中新增電影或影集媒體庫，即可在此瀏覽。"
