    "You're already checked in to something else on Trakt until %@." : {
      "comment" : "Check-in conflict with the time it ends",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er allerede checket ind på noget andet hos Trakt, indtil %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist bei Trakt bereits bei etwas anderem eingecheckt, bis %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya tienes un check-in en otra cosa en Trakt hasta %@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traktissa olet jo check-inattuna johonkin muuhun %@ asti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes déjà en check-in sur autre chose sur Trakt jusqu'au %@."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú ert þegar með innritun í eitthvað annað á Trakt til %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai già effettuato il check-in su un'altra cosa su Trakt fino al %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trakt では %@ まで別の作品にチェックインしています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trakt에서 %@까지 다른 항목에 이미 체크인되어 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er allerede sjekket inn på noe annet på Trakt til %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masz już zameldowanie w czymś innym w Trakt do %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você já tem um check-in em outra coisa no Trakt até %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du är redan incheckad på något annat på Trakt fram till %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已在 Trakt 上签到其他内容，直到 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您已在 Trakt 上簽到其他內容，直到 %@。"
          }
        }
      }
    },
