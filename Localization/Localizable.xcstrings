          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Köpet gick igenom, men Pro har inte aktiverats än. Testa ”Återställ köp” om en stund."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "购买已完成，但 Pro 尚未开启。请稍后尝试“恢复购买”。"
          }
