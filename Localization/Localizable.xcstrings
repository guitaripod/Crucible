    "The purchase could not be completed. You have not been charged. Try again, or use Restore Purchases if you already own Pro." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Købet kunne ikke gennemføres. Du er ikke blevet opkrævet. Prøv igen, eller brug »Gendan køb«, hvis du allerede ejer Pro."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kauf konnte nicht abgeschlossen werden. Dir wurde nichts berechnet. Versuche es erneut oder nutze „Käufe wiederherstellen“, wenn du Pro bereits besitzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo completar la compra. No se te ha cobrado nada. Inténtalo de nuevo o usa Restaurar compras si ya tienes Pro."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostoa ei voitu suorittaa loppuun. Sinulta ei ole veloitettu mitään. Yritä uudelleen tai valitse ”Palauta ostot”, jos omistat jo Pro-version."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’achat n’a pas pu être finalisé. Aucun montant ne vous a été débité. Réessayez ou utilisez Restaurer les achats si vous possédez déjà Pro."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekki var hægt að ljúka kaupunum. Ekki hefur verið rukkað. Reyndu aftur, eða notaðu „Endurheimta kaup“ ef þú átt Pro nú þegar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'acquisto non è stato completato. Non ti è stato addebitato nulla. Riprova oppure usa Ripristina acquisti se possiedi già Pro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購入を完了できませんでした。料金は請求されていません。もう一度お試しいただくか、Pro をすでに所有している場合は「購入を復元」を使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구매를 완료할 수 없었어요. 요금은 청구되지 않았어요. 다시 시도하거나, 이미 Pro를 구매했다면 구매 복원을 사용하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjøpet kunne ikke fullføres. Du er ikke belastet. Prøv igjen, eller bruk «Gjenopprett kjøp» hvis du allerede eier Pro."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się dokończyć zakupu. Nie pobrano opłaty. Spróbuj ponownie albo użyj Przywróć zakupy, jeśli masz już Pro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível concluir a compra. Você não foi cobrado. Tente novamente ou use Restaurar compras se já tiver o Pro."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Köpet kunde inte slutföras. Du har inte debiterats. Försök igen, eller använd ”Återställ köp” om du redan har Pro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法完成购买。你未被扣费。请重试，如果你已拥有 Pro，请使用“恢复购买”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法完成購買，您尚未被收費。請再試一次；若您已購買 Pro，請使用「還原購買項目」。"
          }
        }
      }
    },
    "The purchase went through but Pro has not turned on yet. Try Restore Purchases in a moment." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Købet blev gennemført, men Pro er ikke aktiveret endnu. Prøv »Gendan køb« om lidt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kauf wurde durchgeführt, Pro ist aber noch nicht aktiv. Versuche gleich „Käufe wiederherstellen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La compra se ha realizado, pero Pro aún no se ha activado. Prueba Restaurar compras en un momento."
