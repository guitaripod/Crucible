    "Turn Home's rows on or off and put them in the order you like." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå Hjemmerækker til eller fra, og sæt dem i den rækkefølge, du foretrækker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte die Reihen auf Start ein oder aus und ordne sie, wie du möchtest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa o desactiva las filas de Inicio y ponlas en el orden que quieras."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota Etusivun rivit käyttöön tai pois käytöstä ja järjestä ne haluamaasi järjestykseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez ou désactivez les rangées de l’accueil et mettez-les dans l’ordre de votre choix."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kveiktu eða slökktu á röðunum á Heim og raðaðu þeim eins og þú vilt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva o disattiva le righe della Home e mettile nell'ordine che preferisci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホームの行をオンまたはオフにして、好きな順番に並べられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈 행을 켜거나 끄고 원하는 순서로 정리하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå hjemradene av eller på og ordne dem slik du vil."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz lub wyłącz wiersze ekranu Start i ułóż je w wybranej kolejności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative ou desative as linhas do Início e coloque-as na ordem que preferir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på eller av startraderna på Hem och ordna dem i den ordning du vill."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启或关闭首页行，并按你喜欢的顺序排列。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟或關閉首頁列，並依您喜歡的順序排列。"
          }
        }
      }
    },
    "Turn on Default Server for each, or requests have nowhere to go." : {
      "comment" : "Seerr guide: default server",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå Standardserver til for hver enkelt, ellers har anmodninger ingen steder at gå hen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere „Standardserver“ für jeden, sonst haben Anfragen kein Ziel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Servidor por Defecto en cada uno, o las solicitudes no tendrán adónde ir."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota Oletuspalvelin käyttöön jokaiselle, muuten pyynnöillä ei ole minne mennä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Serveur par défaut pour chacun, sinon les demandes n’ont nulle part où aller."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kveiktu á „Sjálfgefinn þjónn“ fyrir hvern, annars hafa beiðnir hvergi að fara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva Server predefinito per ciascuno, altrimenti le richieste non hanno dove andare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それぞれで「デフォルトサーバー」をオンにしてください。オンにしないと、リクエストの送り先がなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각각 기본 서버를 켜세요. 그렇지 않으면 요청이 갈 곳이 없어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på «Standardserver» for hver, ellers har forespørsler ingen å gå til."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz Domyślny serwer dla każdego, inaczej prośby nie będą miały dokąd trafić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o Servidor Padrão em cada um, ou os pedidos não terão para onde ir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på ”Standardserver” för var och en, annars har begäranden inget att gå till."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请为每个服务器打开“默认服务器”，否则请求将无处可去。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一個都要開啟「預設伺服器」，否則請求就無處可去。"
          }
        }
      }
    },
    "Turn on if Trakt's own Plex sync, PlexTraktSync or a webhook already records them, so nothing counts twice." : {
      "comment" : "Explanation of the Another App Records My Plays setting",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå til, hvis Trakts egen Plex-sync, PlexTraktSync eller en webhook allerede registrerer dem, så intet tæller dobbelt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einschalten, wenn Trakts eigener Plex-Sync, PlexTraktSync oder ein Webhook sie bereits erfasst, damit nichts doppelt zählt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actívalo si la sincronización de Plex de Trakt, PlexTraktSync o un webhook ya los registran, para que nada cuente dos veces."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota käyttöön, jos Traktin oma Plex-synkronointi, PlexTraktSync tai webhook kirjaa ne jo, jotta mikään ei lasketa kahdesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez si la synchro Plex de Trakt, PlexTraktSync ou un webhook les enregistre déjà, pour que rien ne soit compté deux fois."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kveiktu á þessu ef eigin Plex-samstilling Trakt, PlexTraktSync eða vefkrókur skrá þær nú þegar, svo ekkert telst tvisvar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva se la sincronizzazione Plex di Trakt, PlexTraktSync o un webhook li registrano già, così nulla viene conteggiato due volte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trakt 独自の Plex 同期、PlexTraktSync、ウェブフックがすでに記録している場合にオンにしてください。二重に数えられることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trakt의 Plex 동기화, PlexTraktSync 또는 웹훅이 이미 기록하고 있다면 켜세요. 그러면 두 번 집계되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på hvis Trakts egen Plex-synk, PlexTraktSync eller en webhook allerede registrerer dem, slik at ingenting telles dobbelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz, jeśli synchronizacja Plex w Trakt, PlexTraktSync lub webhook już je zapisuje, aby nic nie liczyło się podwójnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative se a sincronização Plex do Trakt, o PlexTraktSync ou um webhook já os registrar, para que nada conte duas vezes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på om Trakts egen Plex-synk, PlexTraktSync eller en webhook redan registrerar dem, så att ingenting räknas två gånger."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果 Trakt 自带的 Plex 同步、PlexTraktSync 或 webhook 已在记录，请开启此项，以免重复计算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若 Trakt 內建的 Plex 同步、PlexTraktSync 或 webhook 已在記錄，請開啟此項，以免重複計算。"
          }
        }
      }
    },
    "Turn rows back on in Settings › Home." : {
      "comment" : "Message on the empty Home screen when the viewer turned its rows off",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå rækker til igen under Indstillinger › Hjem."
