    "Original plays the file as it is whenever the device can. A lower quality asks the server to convert it to that bitrate." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Original spielt die Datei unverändert ab, wann immer das Gerät es kann. Eine niedrigere Qualität bittet den Server, sie auf diese Bitrate umzuwandeln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Original reproduce el archivo tal cual siempre que el dispositivo puede. Una calidad menor pide al servidor convertirlo a esa tasa de bits."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’option Original lit le fichier tel quel dès que l’appareil le permet. Une qualité inférieure demande au serveur de le convertir à ce débit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Originale riproduce il file così com'è, ogni volta che il dispositivo può. Una qualità inferiore chiede al server di convertirlo a quel bitrate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「オリジナル」は、デバイスが対応している限り、ファイルをそのまま再生します。低い画質を選ぶと、サーバーにそのビットレートへの変換を依頼します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원본은 기기가 재생할 수 있으면 파일을 그대로 재생해요. 더 낮은 화질은 서버에 그 비트레이트로 변환을 요청해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oryginalna jakość odtwarza plik bez zmian, gdy urządzenie na to pozwala. Niższa jakość każe serwerowi przekonwertować go do tej przepływności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Original reproduz o arquivo como ele está sempre que o dispositivo puder. Uma qualidade menor pede ao servidor que o converta para essa taxa de bits."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备支持时，“原始”会按文件原样播放。较低画质会让服务器将其转换为对应的比特率。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「原始」會在裝置允許時直接播放檔案。較低畫質會要求伺服器將其轉換為對應的位元速率。"
          }
        }
      }
    },
