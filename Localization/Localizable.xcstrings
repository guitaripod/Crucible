          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instale o Tailscale no computador do Plex e nesta Apple TV, com a mesma conta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installera Tailscale på Plex-datorn och på den här Apple TV och logga in med samma konto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
