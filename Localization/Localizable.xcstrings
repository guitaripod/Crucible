    "Filter by genre and watch state, sort, and jump with the A–Z index." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtrér efter genre og visningsstatus, sortér og hop med A–Z-indekset."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtere nach Genre und Sehstatus, sortiere und springe mit dem A–Z-Index."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtra por género y estado de visualización, ordena y salta con el índice A-Z."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suodata tyylilajin ja katselutilan mukaan, lajittele ja hyppää A–Z-hakemistoon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtrez par genre et état de visionnage, triez et accédez rapidement avec l’index A–Z."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Síaðu eftir tegund og áhorfsstöðu, raðaðu og stökktu með A–Z-vísitölunni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtra per genere e stato di visione, ordina e salta con l'indice A–Z."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジャンルと視聴状況で絞り込み、並べ替え、A–Z インデックスで移動できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장르와 시청 상태로 필터링하고, 정렬하고, A–Z 색인으로 이동하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtrer etter sjanger og visningsstatus, sorter og hopp med A–Z-indeksen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtruj według gatunku i stanu oglądania, sortuj i przechodź za pomocą indeksu A–Z."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtre por gênero e estado de exibição, ordene e pule com o índice A–Z."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtrera efter genre och visningsstatus, sortera och hoppa med A–Z-indexet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按类型和观看状态筛选、排序，并可通过 A–Z 索引快速跳转。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依類型與觀看狀態篩選、排序，並可透過 A–Z 索引快速跳轉。"
