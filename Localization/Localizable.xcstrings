    "You appear to be offline. Check your connection and try again. You have not been charged." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du ser ud til at være offline. Tjek din forbindelse, og prøv igen. Du er ikke blevet opkrævet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du scheinst offline zu sein. Prüfe deine Verbindung und versuche es erneut. Dir wurde nichts berechnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que no tienes conexión. Comprueba tu conexión e inténtalo de nuevo. No se te ha cobrado nada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää siltä, että olet offline-tilassa. Tarkista yhteys ja yritä uudelleen. Sinulta ei ole veloitettu mitään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous semblez hors connexion. Vérifiez votre connexion et réessayez. Aucun montant ne vous a été débité."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svo virðist sem þú sért án nettengingar. Athugaðu tenginguna og reyndu aftur. Þú hefur ekki verið rukkaður."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembra che tu sia offline. Controlla la connessione e riprova. Non ti è stato addebitato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフラインのようです。接続を確認して、もう一度お試しください。料金は請求されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오프라인 상태인 것 같아요. 연결을 확인하고 다시 시도해 주세요. 요금은 청구되지 않았어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du ser ut til å være frakoblet. Sjekk tilkoblingen og prøv igjen. Du er ikke belastet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wygląda na to, że jesteś offline. Sprawdź połączenie i spróbuj ponownie. Nie pobrano opłaty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você parece estar offline. Verifique sua conexão e tente novamente. Você não foi cobrado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du verkar vara offline. Kontrollera anslutningen och försök igen. Du har inte debiterats."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你似乎处于离线状态。请检查网络连接后重试。你未被扣费。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您似乎已離線。請檢查連線，然後再試一次。您尚未被收費。"
          }
        }
      }
    },
    "You finished a season. Tap to rate the show, or press and hold for quick stars." : {
      "comment" : "Body of a reminder to rate a show after finishing a season of unknown number",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har afsluttet en sæson. Tryk for at bedømme serien, eller tryk længe for hurtige stjerner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast eine Staffel beendet. Tippe, um die Serie zu bewerten, oder drücke lange für schnelle Sterne."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has terminado una temporada. Toca para valorar la serie, o mantén pulsado para valorar rápido con estrellas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katsoit kauden loppuun. Arvostele sarja napauttamalla tai paina pitkään pikatähtien valitsemiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez terminé une saison. Touchez pour noter la série, ou appuyez longuement pour noter rapidement avec des étoiles."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú kláraðir þáttaröð. Ýttu til að gefa sjónvarpsþáttaröðinni einkunn, eða haltu inni fyrir fljótlegar stjörnur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai finito una stagione. Tocca per valutare la serie, o tieni premuto per le stelle veloci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シーズンの視聴を終えました。タップして番組を評価するか、長押しで星をすばやく付けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시즌 시청을 마쳤어요. 탭해서 시리즈에 평점을 매기거나, 길게 눌러 별점을 바로 매기세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du fullførte en sesong. Trykk for å vurdere serien, eller trykk og hold for raske stjerner."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukończono sezon. Stuknij, aby ocenić serial, albo przytrzymaj, aby szybko wybrać gwiazdki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você terminou uma temporada. Toque para avaliar a série, ou pressione e segure para dar estrelas rápido."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har avslutat en säsong. Tryck för att betygsätta serien, eller tryck och håll för snabba stjärnor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已看完一季。点按为剧集评分，或长按快速选择星级。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您已看完一季。輕點即可為影集評分，或按住快速選擇星等。"
          }
        }
      }
    },
