    "Reminders and the recap wait until 9:00 instead of arriving between 22:00 and 9:00." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Påmindelser og opsummeringen venter til 9:00 i stedet for at komme mellem 22:00 og 9:00."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erinnerungen und der Rückblick warten bis 9:00 Uhr, statt zwischen 22:00 und 9:00 Uhr einzutreffen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los recordatorios y el resumen esperan a las 9:00 en lugar de llegar entre las 22:00 y las 9:00."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muistutukset ja koonti odottavat klo 9.00 asti, eivätkä saavu klo 22.00 ja 9.00 välillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rappels et le bilan attendent 9 h au lieu d’arriver entre 22 h et 9 h."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Áminningar og yfirlitið bíða til 9:00 í stað þess að berast milli 22:00 og 9:00."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promemoria e riepilogo aspettano le 9:00 invece di arrivare tra le 22:00 e le 9:00."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リマインダーと週間まとめは、22:00 から 9:00 の間には届かず、9:00 まで待ってから届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알림과 주간 요약은 22:00~9:00 사이에 오지 않고 9:00까지 기다렸다가 와요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Påminnelser og oppsummeringen venter til 09:00 i stedet for å komme mellom 22:00 og 09:00."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przypomnienia i podsumowanie czekają do 9:00 zamiast przychodzić między 22:00 a 9:00."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lembretes e o resumo esperam até as 9:00, em vez de chegar entre 22:00 e 9:00."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Påminnelser och sammanfattningen väntar till 9:00 i stället för att komma mellan 22:00 och 9:00."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提醒和回顾会推迟到 9:00 再发送，而不是在 22:00 至 9:00 之间送达。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提醒與每週摘要會延到 9:00 才送出，不會在 22:00 至 9:00 之間送達。"
          }
        }
      }
    },
