    "Every episode and film you watch is checked off on Trakt by itself, downloads too once you're back online." : {
      "comment" : "Trakt benefit detail: automatic scrobbling",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert afsnit og hver film, du ser, bliver automatisk afkrydset på Trakt, og hentede titler også, så snart du er online igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Folge und jeder Film, den du schaust, wird bei Trakt automatisch abgehakt, Downloads ebenso, sobald du wieder online bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada episodio y película que ves se marca como visto en Trakt solo, y las descargas también en cuanto vuelves a tener conexión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokainen katsomasi jakso ja elokuva merkitään Traktiin automaattisesti, samoin lataukset, kun olet taas verkossa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque épisode et chaque film que vous regardez est marqué comme vu sur Trakt automatiquement, et les téléchargements aussi dès que vous êtes de nouveau en ligne."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver þáttur og kvikmynd sem þú horfir á er sjálfkrafa skráð á Trakt, niðurhöl líka um leið og þú ert aftur á netinu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni episodio e film che guardi viene segnato su Trakt in automatico, anche i download appena torni online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "観たエピソードや映画は自動で Trakt にチェックされ、ダウンロードして観た分もオンラインに戻ると記録されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보는 모든 에피소드와 영화가 Trakt에 자동으로 체크돼요. 다운로드한 항목도 다시 온라인이 되면 체크돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver episode og film du ser, blir automatisk krysset av på Trakt, nedlastinger også, så snart du er tilbake på nett."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
