    "“%@” will be deleted from this device. You can download it again later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird von diesem Gerät gelöscht. Du kannst es später erneut herunterladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» se eliminará de este dispositivo. Puedes volver a descargarlo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » sera supprimé de cet appareil. Vous pourrez le télécharger à nouveau plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” verrà eliminato da questo dispositivo. Potrai scaricarlo di nuovo più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」をこのデバイスから削除します。後で再度ダウンロードできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” 항목은 이 기기에서 삭제돼요. 나중에 다시 다운로드할 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” zostanie usunięty z tego urządzenia. Możesz pobrać go ponownie później."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” será excluído deste dispositivo. Você pode baixá-lo novamente depois."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”将从此设备中删除。你之后可以重新下载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」將從此裝置刪除。之後可以再次下載。"
          }
        }
      }
    },
