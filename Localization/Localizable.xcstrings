          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvikmyndir og þættir sem þú sækir birtast hér og eru tilbúnir til áhorfs án nettengingar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I film e gli episodi che scarichi appaiono qui, pronti per essere guardati offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードした映画やエピソードがここに表示され、オフラインで視聴できます。"
