        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tämä on pois päältä, lataukset odottavat Wi-Fi-yhteyttä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé, les téléchargements attendent le Wi-Fi."
