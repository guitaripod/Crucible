        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible Server svarer ikke. Sjekk at datamaskinen med Plex er på, og at den er på dette nettverket eller i tailnetet ditt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible Server nie odpowiada. Sprawdź, czy komputer z Plexem jest włączony i czy jest w tej samej sieci lub w Twoim tailnecie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Crucible Server não está respondendo. Verifique se o computador com Plex está ligado e nesta rede ou no seu tailnet."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible Server svarar inte. Kontrollera att datorn med Plex är på och finns i det här nätverket eller i ditt tailnet."
          }
