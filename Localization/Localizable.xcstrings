    "Used on mobile data, to keep a movie from using up your plan." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird im Mobilfunknetz genutzt, damit ein Film dein Datenvolumen nicht aufbraucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa con datos móviles, para que una película no agote tu tarifa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé en données mobiles, pour éviter qu’un film n’épuise votre forfait."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usato con i dati mobili, per evitare che un film consumi il tuo piano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モバイルデータ通信で使われ、映画でデータ容量を使い切らないようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모바일 데이터에서 영화가 요금제 데이터를 다 쓰지 않도록 해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używane w transmisji komórkowej, aby film nie zużył Twojego pakietu danych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado em dados móveis, para que um filme não consuma seu plano."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于移动数据，避免电影耗尽你的套餐流量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用行動數據時套用，避免電影耗盡您的方案流量。"
          }
        }
      }
    },
    "Used when the server is reached over the internet or Plex Relay, where upload speed is often the limit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird genutzt, wenn der Server über das Internet oder Plex Relay erreicht wird, wo oft die Upload-Geschwindigkeit der Engpass ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa cuando se llega al servidor por internet o por el Relay de Plex, donde a menudo el límite es la velocidad de subida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé lorsque le serveur est joint par Internet ou par le relais Plex, où la vitesse d’envoi est souvent le facteur limitant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usato quando si raggiunge il server via internet o Relay Plex, dove spesso il limite è la velocità di upload."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インターネットまたは Plex リレー経由でサーバーに接続する場合に使われます。この場合は多くの場合、アップロード速度が上限になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버에 인터넷이나 Plex 릴레이로 연결할 때 사용해요. 이런 경우에는 업로드 속도가 제한 요인인 경우가 많아요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używane, gdy do serwera łączysz się przez internet lub Przekaźnik Plex, gdzie ograniczeniem bywa prędkość wysyłania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado quando o servidor é acessado pela internet ou pelo Relay do Plex, onde a velocidade de upload costuma ser o limite."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当通过互联网或 Plex 中继连接服务器时使用，此时上传速度通常是瓶颈。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過網際網路或 Plex 中繼連線至伺服器時使用，這時上傳速度通常是限制。"
          }
        }
      }
    },
    "Uses your home network's address for the server whenever it answers there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzt die Adresse deines Heimnetzwerks für den Server, sobald er dort antwortet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la dirección de tu red doméstica para el servidor siempre que responda ahí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise l’adresse de votre réseau domestique pour le serveur chaque fois qu’il répond là."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa l'indirizzo della rete di casa per il server ogni volta che risponde lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーが自宅のネットワークで応答する場合は、そのアドレスを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버가 집 네트워크에서 응답하면 항상 집 네트워크 주소를 사용해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używa adresu Twojej sieci domowej dla serwera, zawsze gdy tam odpowiada."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa o endereço da sua rede doméstica para o servidor sempre que ele responder ali."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要服务器在家庭网络地址上响应，就使用该地址连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要伺服器在家中網路回應，就會使用家中網路的位址。"
          }
        }
      }
    },
