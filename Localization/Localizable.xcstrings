    "Crucible Pro could not be loaded because you appear to be offline. Check your connection and try again." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible Pro kunne ikke indlæses, fordi du tilsyneladende er offline. Tjek din forbindelse, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible Pro konnte nicht geladen werden, da du offenbar offline bist. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo cargar Crucible Pro porque parece que no tienes conexión. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible Pro ei latautunut, koska laitteesi näyttää olevan offline-tilassa. Tarkista yhteytesi ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible Pro n’a pas pu être chargé, vous semblez hors connexion. Vérifiez votre connexion et réessayez."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekki var hægt að hlaða Crucible Pro því þú virðist vera án nettengingar. Athugaðu tenginguna og reyndu aftur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile caricare Crucible Pro perché sembri offline. Controlla la connessione e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフラインのため Crucible Pro を読み込めませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오프라인 상태인 것 같아 Crucible Pro를 불러올 수 없어요. 연결을 확인하고 다시 시도해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible Pro kunne ikke lastes inn fordi du ser ut til å være frakoblet. Sjekk tilkoblingen og prøv igjen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się wczytać Crucible Pro, ponieważ wygląda na to, że jesteś offline. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível carregar o Crucible Pro porque você parece estar offline. Verifique sua conexão e tente novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible Pro kunde inte läsas in eftersom du verkar vara offline. Kontrollera anslutningen och försök igen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
