          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve para assistir offline, com o progresso na Tela de Bloqueio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存后可离线观看，并在锁定屏幕上显示进度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存後可離線觀看，並在鎖定畫面顯示進度。"
          }
        }
      }
    },
    "Saved fields are locked, so the server keeps them when it refreshes the title." : {
      "comment" : "Note under the Edit Details form",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeicherte Felder sind gesperrt, damit der Server sie beim Aktualisieren des Titels behält."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los campos guardados se bloquean para que el servidor los conserve al actualizar el título."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les champs enregistrés sont verrouillés pour que le serveur les conserve lorsqu’il actualise le titre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I campi salvati sono bloccati, così il server li mantiene quando aggiorna il titolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存された項目はロックされるため、タイトルを更新してもサーバーに保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장한 항목은 잠겨 있어서 서버가 제목을 새로 고쳐도 그대로 유지돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisane pola są zablokowane, więc serwer zachowa je przy odświeżaniu tytułu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os campos salvos ficam bloqueados, para que o servidor os mantenha ao atualizar o título."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存的字段会被锁定，以便服务器刷新标题时保留这些内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已儲存的欄位會鎖定，伺服器重新整理作品時會保留這些內容。"
          }
        }
      }
    },
