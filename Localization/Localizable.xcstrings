    "Pay once. Every update, on every device." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betal én gang. Alle opdateringer på alle enheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal zahlen. Alle Updates, auf jedem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un solo pago. Todas las actualizaciones, en todos los dispositivos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksa kerran. Kaikki päivitykset jokaisella laitteella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un seul paiement. Toutes les mises à jour, sur tous vos appareils."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greiddu einu sinni. Allar uppfærslur á hverju tæki."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paga una volta. Ogni aggiornamento, su ogni dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度の購入で、すべてのアップデートをすべてのデバイスで利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번만 결제하면 모든 업데이트를 모든 기기에서 이용할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betal én gang. Alle oppdateringer, på alle enheter."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapłać raz. Każda aktualizacja, na każdym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pague uma vez. Todas as atualizações, em todos os dispositivos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betala en gång. Alla uppdateringar, på alla enheter."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次付费，所有更新，所有设备通用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次付費，每台裝置都享有所有更新。"
          }
        }
      }
    },
