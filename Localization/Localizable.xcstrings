    "Your %@ so far: %@. Preview and share it as a Story or Square poster." : {
      "comment" : "Pro feature summary for the Year in Review poster: the year, then what the viewer watched in it, such as '14 movies · 212 episodes'",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit %@ hidtil: %@. Forhåndsvis og del det som Story eller kvadratisk plakat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein %@ bisher: %@. Sieh dir die Vorschau an und teile es als Story oder quadratisches Poster."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu %@ hasta ahora: %@. Previsualízalo y compártelo como póster de Historias o cuadrado."
          }
        },
