    "Optional: in Seerr's Settings, Services, add Radarr and Sonarr by network address and turn on Default Server." : {
      "comment" : "Seerr guide summary on Apple TV: Radarr and Sonarr",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valgfrit: Tilføj Radarr og Sonarr via deres netværksadresse under Seerrs Indstillinger og Tjenester, og slå Standardserver til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional: Füge in Seerrs Einstellungen unter „Dienste“ Radarr und Sonarr über ihre Netzwerkadresse hinzu und aktiviere „Standardserver“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional: en Ajustes de Seerr, Servicios, agrega Radarr y Sonarr por su dirección de red y activa Servidor por Defecto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valinnainen: lisää Seerrin asetuksissa, kohdassa ”Services”, Radarr ja Sonarr verkko-osoitteella ja ota käyttöön ”Default Server”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif : dans Seerr, Paramètres, Services, ajoutez Radarr et Sonarr par adresse réseau, puis activez Serveur par défaut."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valfrjálst: í Seerr, farðu í Stillingar og Þjónustur, bættu við Radarr og Sonarr með vistfangi þeirra á netinu og kveiktu á „Sjálfgefinn þjónn“."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facoltativo: in Seerr, vai su Impostazioni, Servizi, aggiungi Radarr e Sonarr tramite indirizzo di rete e attiva Server predefinito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意：Seerr の「Settings」、「連携サービス」で、Radarr と Sonarr をネットワークアドレスで追加し、「デフォルトサーバー」をオンにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택 사항: Seerr의 설정, 서비스에서 네트워크 주소로 Radarr와 Sonarr를 추가하고 기본 서버를 켜세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valgfritt: i Seerrs innstillinger, under «Tjenester», legg til Radarr og Sonarr med nettverksadressen og slå på «Standardserver»."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcjonalnie: w Ustawieniach Seerr, w Usługach, dodaj Radarr i Sonarr przez adres sieciowy i włącz Domyślny serwer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional: nas Configurações do Seerr, em Serviços, adicione o Radarr e o Sonarr pelo endereço de rede e ative o Servidor Padrão."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valfritt: i Seerrs Inställningar under Tjänster, lägg till Radarr och Sonarr via nätverksadress och aktivera Standardserver."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可选：在 Seerr 的“设定”、“服务器”中，通过网络地址添加 Radarr 和 Sonarr，并打开“默认服务器”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選用：在 Seerr 的「設定」、「伺服器」中，依網路位址新增 Radarr 和 Sonarr，並開啟「預設伺服器」。"
          }
        }
      }
    },
