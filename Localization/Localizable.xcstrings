    "Downloading, %lld percent. Double tap to pause" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henter, %lld procent. Dobbelttryk for at sætte på pause"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird heruntergeladen, %lld Prozent. Doppeltippen, um anzuhalten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descargando, %lld por ciento. Toca dos veces para pausar"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladataan, %lld prosenttia. Kaksoisnapauta keskeyttääksesi"
          }
        },
        "fr" : {
