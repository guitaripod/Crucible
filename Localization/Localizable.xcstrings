          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haku, Plex-katselulistasi ja sarjan sivu tarjoavat Pyydä-painikkeen kaikelle, mitä palvelimella ei ole."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recherche, votre liste de suivi Plex et la page d’une série proposent « Demander » pour tout ce qui n’est pas sur le serveur."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Í leit, á Plex-áhorfslistanum þínum og á síðu þáttar birtist hnappurinn „Biðja um“ fyrir allt sem er ekki á þjóninum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nella scheda Cerca, nella tua watchlist di Plex e nella pagina di una serie c'è Richiedi per tutto ciò che non è sul server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索、Plex のウォッチリスト、番組のページで、サーバーにない作品には「リクエスト」が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검색, Plex 관심 목록, 시리즈 페이지에서 서버에 없는 작품은 바로 요청할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
