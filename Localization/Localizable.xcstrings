          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopplingskoden är fel eller har gått ut. Kör crucible-server pair för att få en ny."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
