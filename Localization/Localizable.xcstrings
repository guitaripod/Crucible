    },
    "How far one skip goes: a click on the left or right of the Siri Remote's clickpad, or the skip buttons on the Lock Screen, in Control Center and on headphones." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie weit ein Sprung geht: ein Klick links oder rechts auf dem Clickpad der Siri Remote oder die Sprungtasten auf dem Sperrbildschirm, im Kontrollzentrum und auf Kopfhörern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto avanza o retrocede cada salto: un clic a la izquierda o derecha del touchpad del Siri Remote, o los botones de salto en la pantalla de bloqueo, en el Centro de control y en los auriculares."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durée d’un saut : un clic à gauche ou à droite du pavé tactile de la Siri Remote, ou les boutons de saut de l’écran verrouillé, du Centre de contrôle et des écouteurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto avanza ogni salto: un clic a sinistra o a destra del clickpad del Siri Remote, oppure i pulsanti di salto nella schermata di blocco, in Centro di controllo e sulle cuffie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 回のスキップの幅: Siri リモコンのクリックパッドの左右のクリック、またはロック画面、コントロールセンター、ヘッドフォンのスキップボタンです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번 건너뛸 때 이동하는 길이예요. Siri 리모컨 클릭패드의 왼쪽이나 오른쪽을 클릭하거나, 잠금 화면, 제어 센터, 헤드폰의 건너뛰기 버튼을 사용할 때 적용돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak daleko sięga jedno przeskoczenie: kliknięcie po lewej lub prawej stronie touchpada Siri Remote albo przyciski pomijania na ekranie blokady, w Centrum sterowania i na słuchawkach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Até onde vai cada salto: um clique na esquerda ou na direita do touchpad do Siri Remote, ou os botões de pular na Tela de Bloqueio, na Central de Controle e nos fones de ouvido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单次跳过的时长：点按 Siri 遥控器触控板的左侧或右侧，或使用锁定屏幕、控制中心和耳机上的跳过按钮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "單次跳轉的距離：按下 Siri 遙控器觸控板的左側或右側，或使用鎖定畫面、控制中心及耳機上的跳轉按鈕。"
          }
        }
      }
    },
    "How far the skip buttons on the Lock Screen, in Control Center and on headphones go." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie weit die Überspringen-Tasten im Sperrbildschirm, im Kontrollzentrum und am Kopfhörer springen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta dónde saltan los botones de saltar en la pantalla bloqueada, en el centro de control y en los auriculares."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distance de saut des boutons de l’écran verrouillé, du centre de contrôle et des écouteurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di quanto saltano i pulsanti nella schermata di blocco, nel Centro di Controllo e sulle cuffie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロック画面、コントロールセンター、ヘッドフォンのスキップボタンで移動する長さ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠금 화면, 제어 센터, 헤드폰에서 건너뛰기 버튼이 이동하는 거리예요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ile przeskakują przyciski pomijania na ekranie blokady, w centrum sterowania i na słuchawkach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Até onde vão os botões de pular na Tela Bloqueada, na Central de Controle e nos fones de ouvido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "锁定屏幕、控制中心和耳机上的跳过按钮所跳过的时长。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鎖定畫面、控制中心與耳機上的跳轉按鈕要跳過多長時間。"
          }
        }
      }
    },
    "How long the Up Next card waits before the next episode starts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie lange die Karte „Als Nächstes“ wartet, bevor die nächste Folge startet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto espera la tarjeta A continuación antes de que empiece el siguiente episodio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durée d’attente de la carte « À suivre » avant le début de l’épisode suivant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto attende la scheda Prossimo prima che parta l'episodio successivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「次に見る」カードが表示されてから、次のエピソードが始まるまでの時間。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 에피소드가 시작되기 전까지 다음 재생 카드가 기다리는 시간이에요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak długo karta Następne czeka, zanim ruszy kolejny odcinek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto tempo o cartão A seguir espera antes de o próximo episódio começar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“接下来播放”卡片在下一集开始前等待的时长。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接著播放卡片要等待多久，下一集才會開始。"
          }
        }
      }
    },
    "How was %@?" : {
