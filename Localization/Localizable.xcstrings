    "Sunday evening: how much you watched this week, quietly, without a sound." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søndag aften: hvor meget du har set i denne uge, stille og roligt, uden lyd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonntagabend: wie viel du diese Woche gesehen hast, dezent und ohne Ton."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domingo por la noche: cuánto viste esta semana, en silencio, sin ningún sonido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunnuntai-ilta: kuinka paljon katsoit tällä viikolla, hiljaa ja ilman ääntä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimanche soir : ce que vous avez regardé cette semaine, discrètement, sans son."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunnudagskvöld: hversu mikið þú horfðir á í þessari viku, rólega, án hljóðs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domenica sera: quanto hai guardato questa settimana, in silenzio, senza suoni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日曜の夜に、今週の視聴時間を通知センターに配信します。音は鳴りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일요일 저녁: 이번 주에 얼마나 봤는지 소리 없이 조용히 알려 드려요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søndag kveld: hvor mye du så denne uken, stille, uten lyd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niedzielny wieczór: ile oglądania w tym tygodniu, po cichu, bez dźwięku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domingo à noite: quanto você assistiu esta semana, sem alarde, sem som."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Söndagskväll: hur mycket du tittade den här veckan, tyst och utan ljud."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "周日晚上：静默送达本周观看时长，不发出声音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "週日晚上：安靜無聲地告訴您本週看了多少。"
          }
        }
      }
    },
