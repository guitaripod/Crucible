      }
    },
    "The quality new downloads start at. You can still pick another one for each download." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den kvalitet nye downloads starter med. Du kan stadig vælge en anden for hver download."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Qualität, mit der neue Downloads starten. Für jeden Download kannst du trotzdem eine andere wählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La calidad con la que empiezan las nuevas descargas. Aún puedes elegir otra para cada descarga."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uusien latausten oletuslaatu. Voit silti valita jokaiselle lataukselle toisen laadun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La qualité de départ des nouveaux téléchargements. Vous pouvez toujours en choisir une autre pour chaque téléchargement."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upphafsgæði nýs niðurhals. Þú getur samt valið önnur gæði fyrir hvert niðurhal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La qualità con cui partono i nuovi download. Puoi scegliere un'altra qualità per ogni download."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいダウンロードの初期画質です。ダウンロードごとに別の画質を選ぶこともできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 다운로드가 시작될 때의 화질이에요. 각 다운로드마다 다른 화질을 고를 수도 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvaliteten nye nedlastinger starter på. Du kan fortsatt velge en annen for hver nedlasting."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jakość, od której zaczynają się nowe pobrania. Dla każdego pobrania możesz wybrać inną."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A qualidade com que os novos downloads começam. Você ainda pode escolher outra para cada download."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvaliteten som nya hämtningar startar med. Du kan fortfarande välja en annan för varje hämtning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新下载默认使用的画质。你仍可为每个下载单独选择其他画质。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
