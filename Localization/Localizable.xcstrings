    "Step by step, with the commands for your server" : {
      "comment" : "Subtitle of the row that opens the Seerr setup guide",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trin for trin, med kommandoerne til din server"
          }
