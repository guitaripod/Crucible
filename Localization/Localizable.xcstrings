    "Approve, decline and retry everyone's Seerr requests from the couch." : {
      "comment" : "Pro feature summary for managing Seerr requests",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godkend, afvis og send alles Seerr-anmodninger igen, direkte fra sofaen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anfragen aller in Seerr genehmigen, ablehnen und erneut senden, direkt vom Sofa aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprueba, rechaza y reintenta las solicitudes de Seerr de todos desde el sofá."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hyväksy, hylkää ja yritä uudelleen kaikkia Seerr-pyyntöjä sohvalta käsin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approuvez, refusez et relancez les demandes Seerr de tout le monde depuis le canapé."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samþykkja, hafna og senda aftur beiðnir allra í Seerr úr sófanum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approva, rifiuta e riprova le richieste Seerr di tutti dal divano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソファに座ったままでも、全員のSeerrリクエストを承認・拒否・再試行できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소파에서 편하게 모든 사람의 Seerr 요청을 승인, 거절, 재시도할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godkjenn, avslå og prøv igjen alles Seerr-forespørsler fra sofaen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatwierdzaj, odrzucaj i ponawiaj prośby Seerr wszystkich, wygodnie z kanapy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprove, recuse e refaça as solicitações do Seerr de todo mundo do sofá."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godkänn, avböj och försök igen med allas Seerr-begäranden från soffan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在沙发上就能批准、拒绝和重试所有人的 Seerr 请求。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
