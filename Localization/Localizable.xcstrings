    "How Crucible plays what you pick from your server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So spielt Crucible die Inhalte ab, die du von deinem Server auswählst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo reproduce Crucible lo que eliges de tu servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comment Crucible lit les contenus que vous choisissez sur votre serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come Crucible riproduce ciò che scegli dal tuo server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーから選んだ内容を Crucible がどのように再生するかです。"
          }
        },
        "ko" : {
          "stringUnit" : {
