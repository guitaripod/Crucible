          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible loggar ut dig från Seerr på den här enheten. Dina begäranden finns kvar i Seerr."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible 将在此设备上退出 Seerr。你的请求仍保留在 Seerr 中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible 會在此裝置上登出 Seerr。你的請求仍會保留在 Seerr 中。"
          }
        }
      }
    },
    "Crucible stops scrobbling and keeps everything else." : {
