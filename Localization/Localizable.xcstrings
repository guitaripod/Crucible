    "This Seerr takes whole shows only, so every missing season is requested." : {
      "comment" : "Note when Seerr does not allow requesting single seasons",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne Seerr accepterer kun hele serier, så alle manglende sæsoner bliver anmodet om."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Seerr nimmt nur ganze Serien an, daher werden alle fehlenden Staffeln angefragt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Seerr solo admite series completas, así que se solicitan todas las temporadas que faltan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä Seerr hyväksyy vain koko sarjat, joten kaikki puuttuvat kaudet pyydetään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Seerr n'accepte que des séries entières : toutes les saisons manquantes sont demandées."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þessi Seerr tekur aðeins við heilum sjónvarpsþáttaröðum, þannig að allar vantandi þáttaraðir eru beðnar um."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo Seerr accetta solo serie intere, quindi vengono richieste tutte le stagioni mancanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このSeerrは番組単位でのみ受け付けるため、不足しているすべてのシーズンがリクエストされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Seerr는 시리즈 단위로만 요청을 받아서, 없는 시즌이 모두 요청돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne Seerr tar bare imot hele serier, så alle manglende sesonger blir bedt om."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten Seerr przyjmuje tylko całe seriale, więc zgłaszane są wszystkie brakujące sezony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Seerr aceita só séries inteiras, então todas as temporadas que faltam são solicitadas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här Seerr tar bara emot hela serier, så alla saknade säsonger begärs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Seerr 只接受整部剧集的请求，因此会请求所有缺失的季。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Seerr 只接受整部影集的請求，因此會請求所有缺少的季。"
