    "It didn’t answer as your server, so Crucible stays on the connection it uses now." : {
      "comment" : "Alert when a picked server connection does not answer",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den svarede ikke som din server, så Crucible bliver på den forbindelse, den bruger nu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie hat nicht als dein Server geantwortet, daher bleibt Crucible bei der aktuellen Verbindung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No respondió como tu servidor, así que Crucible sigue con la conexión que usa ahora."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ei vastannut palvelimenasi, joten Crucible pysyy nykyisessä yhteydessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle n’a pas répondu comme votre serveur, Crucible garde donc la connexion actuelle."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tengingin svaraði ekki sem þjónninn þinn, svo Crucible heldur áfram með þá tengingu sem er í notkun núna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ha risposto come il tuo server, quindi Crucible resta sulla connessione attuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーとして応答しなかったため、Crucible は現在の接続を使い続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버로 응답하지 않아서 Crucible은 지금 쓰는 연결을 유지해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den svarte ikke som serveren din, så Crucible beholder forbindelsen den bruker nå."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie odpowiedziało jako Twój serwer, więc Crucible zostaje przy obecnym połączeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela não respondeu como seu servidor, então o Crucible continua na conexão atual."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den svarade inte som din server, så Crucible behåller den anslutning den använder nu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它没有以你的服务器身份响应，因此 Crucible 继续使用当前连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它沒有以您的伺服器身分回應，因此 Crucible 會繼續使用目前的連線。"
          }
        }
      }
    },
    "It expired or was revoked. Add a new one and Crucible searches your tailnet again." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den er udløbet eller blev tilbagekaldt. Tilføj en ny, så søger Crucible igen i dit tailnet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist abgelaufen oder wurde widerrufen. Füge ein neues hinzu, dann sucht Crucible wieder in deinem Tailnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha caducado o se ha revocado. Añade uno nuevo y Crucible volverá a buscar en tu tailnet."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se on vanhentunut tai peruutettu. Lisää uusi, niin Crucible etsii tailnetistasi uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il a expiré ou a été révoqué. Ajoutez-en un nouveau et Crucible recherchera de nouveau votre tailnet."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hann er útrunninn eða afturkallaður. Bættu við nýjum og Crucible leitar aftur í tailnetinu þínu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È scaduto o è stato revocato. Aggiungine uno nuovo e Crucible cercherà di nuovo nella tua tailnet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "期限切れか取り消されています。新しいトークンを追加すると、Crucible が tailnet を再度検索します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "만료됐거나 취소됐어요. 새 토큰을 추가하면 Crucible이 tailnet을 다시 검색해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den har utløpt eller er tilbakekalt. Legg til en ny, så søker Crucible i tailnetet ditt igjen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wygasł lub został unieważniony. Dodaj nowy, a Crucible ponownie przeszuka Twoją sieć tailnet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele expirou ou foi revogado. Adicione um novo e o Crucible volta a buscar na sua tailnet."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den har gått ut eller återkallats. Lägg till en ny, så letar Crucible efter ditt tailnet igen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它已过期或被撤销。添加新令牌后，Crucible 将重新搜索你的 tailnet。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "權杖已過期或已被撤銷。請新增一個新的權杖，Crucible 會再次搜尋您的 tailnet。"
          }
        }
      }
    },
