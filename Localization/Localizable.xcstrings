    "Install Tailscale on the Plex computer and on this Apple TV, signed in to one account." : {
      "comment" : "Seerr guide summary on Apple TV: Tailscale",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installer Tailscale på Plex-computeren og på dette Apple TV, logget ind med samme konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installiere Tailscale auf dem Plex-Computer und auf diesem Apple TV, angemeldet mit demselben Konto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala Tailscale en el ordenador de Plex y en este Apple TV, con sesión iniciada en la misma cuenta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asenna Tailscale Plex-tietokoneelle ja tälle Apple TV:lle. Kirjaudu molemmilla samaan tiliin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez Tailscale sur l’ordinateur Plex et sur cet Apple TV, connectés avec le même compte."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settu upp Tailscale á Plex-tölvunni og á þessu Apple TV og skráðu þig inn á sama aðganginn."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installa Tailscale sul computer con Plex e su questo Apple TV, con accesso allo stesso account."
          }
        },
        "ja" : {
          "stringUnit" : {
