        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þegar kvikmynd eða síðasti þáttur sjónvarpsþáttaraðar lýkur bíða svipaðir titlar á skjánum í stað þess að spilarinn lokist."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando finisce un film o l’ultimo episodio di una serie, i titoli simili restano sullo schermo invece di chiudere il lettore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
