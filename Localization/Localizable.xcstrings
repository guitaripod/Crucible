    "Connect Seerr in Settings › Integrations first." : {
      "comment" : "Seerr error when nothing is connected",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbind først Seerr under Indstillinger › Integrationer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde zuerst Seerr unter Einstellungen › Integrationen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta Seerr primero en Ajustes › Integraciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhdistä ensin Seerr kohdassa Asetukset › Integraatiot."
          }
        },
        "fr" : {
