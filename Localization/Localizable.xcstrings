      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forlad demoen, og log ind med Plex for at bruge Crucible med dit eget bibliotek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlasse die Demo und melde dich mit Plex an, um Crucible mit deiner eigenen Mediathek zu nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sal de la demo e inicia sesión con Plex para usar Crucible con tu propia biblioteca."
          }
        },
