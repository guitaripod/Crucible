    "Crucible needs it to find a server on your Wi-Fi. Turn it on for Crucible in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible braucht das, um einen Server in deinem WLAN zu finden. Aktiviere es für Crucible in den Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible lo necesita para encontrar un servidor en tu Wi-Fi. Actívalo para Crucible en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible en a besoin pour trouver un serveur sur votre Wi-Fi. Activez-le pour Crucible dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible ne ha bisogno per trovare un server sulla tua Wi-Fi. Attivalo per Crucible nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible が Wi-Fi 上のサーバーを見つけるために必要です。設定で Crucible に対して有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi에서 서버를 찾으려면 이 권한이 필요해요. 설정에서 Crucible의 권한을 켜 주세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible potrzebuje tego, aby znaleźć serwer w Twojej sieci Wi-Fi. Włącz to dla Crucible w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Crucible precisa disso para encontrar um servidor na sua rede Wi-Fi. Ative para o Crucible nos Ajustes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible 需要此权限才能在你的 Wi-Fi 中查找服务器。请在“设置”中为 Crucible 开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible 需要此權限才能在 Wi-Fi 中找到伺服器。請在「設定」中為 Crucible 開啟。"
          }
        }
      }
    },
    "Crucible tested every connection and picked the fastest." : {
      "localizations" : {
