        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你看完的电影和剧集会留在这里，直到你为它们评分。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您看完的電影和節目會留在這裡，直到您為它們評分。"
          }
