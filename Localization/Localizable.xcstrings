    "It expired or was revoked. Add a new one and Crucible searches your tailnet again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist abgelaufen oder wurde widerrufen. Füge ein neues hinzu, dann sucht Crucible wieder in deinem Tailnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha caducado o se ha revocado. Añade uno nuevo y Crucible volverá a buscar en tu tailnet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il a expiré ou a été révoqué. Ajoutez-en un nouveau et Crucible recherchera de nouveau votre tailnet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È scaduto o è stato revocato. Aggiungine uno nuovo e Crucible cercherà di nuovo nella tua tailnet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "期限切れか取り消されています。新しいトークンを追加すると、Crucible が tailnet を再度検索します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "만료됐거나 취소됐어요. 새 토큰을 추가하면 Crucible이 tailnet을 다시 검색해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wygasł lub został unieważniony. Dodaj nowy, a Crucible ponownie przeszuka Twoją sieć tailnet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele expirou ou foi revogado. Adicione um novo e o Crucible volta a buscar na sua tailnet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它已过期或被撤销。添加新令牌后，Crucible 将重新搜索你的 tailnet。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "權杖已過期或已被撤銷。請新增一個新的權杖，Crucible 會再次搜尋您的 tailnet。"
          }
        }
      }
    },
