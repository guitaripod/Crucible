    "How Crucible plays what you pick from your server." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sådan afspiller Crucible det, du vælger fra din server."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So spielt Crucible die Inhalte ab, die du von deinem Server auswählst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo reproduce Crucible lo que eliges de tu servidor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näin Crucible toistaa palvelimeltasi valitsemasi sisällön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comment Crucible lit les contenus que vous choisissez sur votre serveur."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svona spilar Crucible það efni sem þú velur af þjóninum þínum."
          }
