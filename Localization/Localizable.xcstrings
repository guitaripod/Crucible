    "Tailscale didn't accept that token. Check that you copied all of it and that it hasn't expired." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale accepterede ikke dette token. Kontrollér, at du har kopieret det hele, og at det ikke er udløbet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale hat dieses Token nicht akzeptiert. Prüfe, ob du es vollständig kopiert hast und es nicht abgelaufen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale no aceptó ese token. Comprueba que lo has copiado completo y que no haya caducado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale ei hyväksynyt tätä tunnusta. Tarkista, että kopioit koko tunnuksen ja ettei se ole vanhentunut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale n’a pas accepté ce jeton. Vérifiez que vous l’avez copié en entier et qu’il n’a pas expiré."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale tók ekki við þessu tókeni. Athugaðu hvort þú hafir afritað það allt og hvort það sé ekki útrunnið."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale non ha accettato quel token. Controlla di averlo copiato per intero e che non sia scaduto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale がそのトークンを受け付けませんでした。すべてコピーしたか、期限切れでないかを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale이 해당 토큰을 받아들이지 않았어요. 토큰을 전부 복사했는지, 만료되지 않았는지 확인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale godtok ikke dette tokenet. Sjekk at du kopierte alt, og at det ikke er utløpt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale nie zaakceptował tego tokenu. Sprawdź, czy skopiowano go w całości i czy nie wygasł."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Tailscale não aceitou esse token. Verifique se você copiou tudo e se ele não expirou."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale godkände inte den token. Kontrollera att du kopierade hela den och att den inte har gått ut."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale 不接受该令牌。请检查是否完整复制，并确认它没有过期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale 不接受此權杖。請確認已完整複製，且權杖尚未過期。"
          }
        }
      }
    },
