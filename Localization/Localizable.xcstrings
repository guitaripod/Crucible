      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søgningen, din Plex-se-liste og en serieside viser Anmod om for alt, der ikke er på serveren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
