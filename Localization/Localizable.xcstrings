    "Libraries Plex hides from Home start switched off. At least one library stays on." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biblioteker, som Plex skjuler på Hjem, er slået fra som standard. Mindst ét bibliotek forbliver slået til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mediatheken, die Plex auf Start ausblendet, sind zunächst aus. Mindestens eine Mediathek bleibt an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las bibliotecas que Plex oculta de Inicio empiezan desactivadas. Al menos una biblioteca permanece activa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plexin Koti-välilehdeltä piilottamat kirjastot ovat aluksi pois päältä. Vähintään yksi kirjasto pysyy päällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les bibliothèques que Plex masque de l’accueil sont désactivées par défaut. Au moins une bibliothèque reste activée."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Söfn sem Plex felur frá Heim byrja slökkt. Að minnsta kosti eitt safn er áfram kveikt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le librerie che Plex nasconde dalla Home iniziano disattivate. Almeno una libreria resta attiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plex のホームから非表示になっているライブラリは、オフの状態で始まります。少なくとも 1 つのライブラリはオンのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plex 홈에서 숨긴 보관함은 꺼진 상태로 시작해요. 최소 하나의 보관함은 켜진 상태로 유지돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biblioteker som Plex skjuler fra Hjem, er slått av til å begynne med. Minst ett bibliotek må alltid være på."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biblioteki ukryte przez Plex na ekranie głównym zaczynają jako wyłączone. Co najmniej jedna biblioteka pozostaje włączona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As bibliotecas que o Plex oculta do Início começam desativadas. Pelo menos uma biblioteca permanece ativada."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bibliotek som Plex döljer från Hem är avstängda från början. Minst ett bibliotek förblir på."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plex 从首页隐藏的资料库默认关闭。至少保留一个资料库开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plex 預設會從首頁隱藏的媒體庫會先關閉。至少要保留一個媒體庫開啟。"
          }
        }
      }
    },
