    "Crucible Pro could not be loaded because you appear to be offline. Check your connection and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible Pro konnte nicht geladen werden, da du offenbar offline bist. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo cargar Crucible Pro porque parece que no tienes conexión. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible Pro n’a pas pu être chargé, vous semblez hors connexion. Vérifiez votre connexion et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile caricare Crucible Pro perché sembri offline. Controlla la connessione e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフラインのため Crucible Pro を読み込めませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오프라인 상태인 것 같아 Crucible Pro를 불러올 수 없어요. 연결을 확인하고 다시 시도해 주세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się wczytać Crucible Pro, ponieważ wygląda na to, że jesteś offline. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível carregar o Crucible Pro porque você parece estar offline. Verifique sua conexão e tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于你似乎处于离线状态，无法加载 Crucible Pro。请检查网络连接后重试。"
