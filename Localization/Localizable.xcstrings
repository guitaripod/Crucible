        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich erneut an, um Crucible weiter zu nutzen, oder melde dich ab, um dieses Konto von dieser Apple TV zu entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a iniciar sesión para seguir usando Crucible, o cierra sesión para quitar esta cuenta de este Apple TV."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjaudu uudelleen sisään, jotta voit jatkaa Cruciblen käyttöä, tai kirjaudu ulos poistaaksesi tämän tilin tältä Apple TV:ltä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconnectez-vous pour continuer à utiliser Crucible, ou déconnectez-vous pour retirer ce compte de cette Apple TV."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skráðu þig inn aftur til að halda áfram að nota Crucible, eða skráðu þig út til að fjarlægja þennan aðgang af þessari Apple TV."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi di nuovo per continuare a usare Crucible, oppure esci per rimuovere questo account da questa Apple TV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible を引き続き使うには再度サインインするか、この Apple TV からこのアカウントを削除するにはサインアウトしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible을 계속 사용하려면 다시 로그인하거나, 이 Apple TV에서 이 계정을 제거하려면 로그아웃하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logg på igjen for å fortsette å bruke Crucible, eller logg av for å fjerne denne kontoen fra denne Apple TV-en."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaloguj się ponownie, aby dalej korzystać z Crucible, albo wyloguj się, aby usunąć to konto z tego Apple TV."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre novamente para continuar usando o Crucible, ou saia para remover esta conta desta Apple TV."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logga in igen för att fortsätta använda Crucible, eller logga ut för att ta bort kontot från den här Apple TV:n."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请重新登录以继续使用 Crucible，或退出登录以从此 Apple TV 中移除该账户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新登入即可繼續使用 Crucible，或登出以從此 Apple TV 移除此帳號。"
          }
        }
      }
    },
