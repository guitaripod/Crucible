    "Tap a star to rate, or slide across the stars for half stars." : {
      "comment" : "Hint above the Rate What You Watched list, whose rows each carry five stars",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på en stjerne for at bedømme, eller stryg hen over stjernerne for halve stjerner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf einen Stern, um zu bewerten, oder wische über die Sterne für halbe Sterne."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una estrella para valorar o desliza por las estrellas para dar medias estrellas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta tähteä arvostellaksesi tai pyyhkäise tähtien yli puolitähtiä varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une étoile pour noter, ou faites glisser le doigt sur les étoiles pour des demi-étoiles."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ýttu á stjörnu til að gefa einkunn, eða strjúktu yfir stjörnurnar fyrir hálfar stjörnur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca una stella per valutare, oppure scorri sulle stelle per le mezze stelle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "星をタップして評価。星の上をなぞると半分の星も付けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "별을 탭해 평가하거나, 별 위를 밀어서 반 별을 매기세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på en stjerne for å vurdere, eller dra over stjernene for halve stjerner."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij gwiazdkę, aby ocenić, lub przesuń palcem po gwiazdkach, by dać pół gwiazdki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em uma estrela para avaliar ou deslize sobre as estrelas para dar meia estrela."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på en stjärna för att betygsätta, eller dra över stjärnorna för halva stjärnor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点星星即可评分，在星星上滑动可评半星。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下星星即可評分，在星星上滑動可評半顆星。"
          }
        }
      }
    },
    "Tap to rate it, or press and hold for quick stars." : {
      "comment" : "Body of a reminder to rate a title the viewer finished",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk for at bedømme den, eller tryk længe for hurtige stjerner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe, um zu bewerten, oder drücke lange für schnelle Sterne."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca para valorarlo, o mantén pulsado para valorar rápido con estrellas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta arvostellaksesi tai paina pitkään pikatähtiä varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez pour le noter, ou appuyez longuement pour noter rapidement avec des étoiles."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ýttu til að gefa einkunn, eða haltu inni fyrir hraðar stjörnur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca per valutarlo, o tieni premuto per le stelle veloci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タップして評価するか、長押しで星をすばやく付けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭해서 평점을 매기거나, 길게 눌러 별점을 바로 매기세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk for å vurdere, eller hold inne for raske stjerner."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij, aby ocenić, albo przytrzymaj, aby szybko wybrać gwiazdki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque para avaliar, ou pressione e segure para dar estrelas rápido."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck för att betygsätta, eller tryck länge för snabba stjärnor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按评分，或长按快速选择星级。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輕點即可評分，或按住快速選擇星等。"
          }
        }
      }
    },
