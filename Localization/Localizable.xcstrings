    "You're offline and nothing is saved on this iPhone yet." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er offline, og der er endnu intet gemt på denne iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist offline, und auf diesem iPhone ist noch nichts gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tienes conexión y todavía no hay nada guardado en este iPhone."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olet offline-tilassa, eikä tältä iPhonelta ole vielä mitään tallennettuna."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes hors connexion et rien n’est encore enregistré sur cet iPhone."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú ert án nettengingar og ekkert er vistað í þessum iPhone ennþá."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei offline e su questo iPhone non c'è ancora nulla di salvato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフラインで、この iPhone にはまだ何も保存されていません。"
