    "From your watchlist, now on your server. Tap to watch." : {
      "comment" : "Body of the notification for a watchlisted title that arrived on the server",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra din se-liste, nu på din server. Tryk for at se."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von deiner Watchlist, jetzt auf deinem Server. Tippe, um es anzusehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tu lista para ver, ya en tu servidor. Toca para verlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katselulistallasi oleva nimike on nyt palvelimellasi. Katso napauttamalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un titre de votre liste de suivi est maintenant sur votre serveur. Touchez pour le regarder."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Af áhorfslistanum þínum, komið á þjóninn þinn. Ýttu til að horfa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dalla tua Watchlist, ora sul tuo server. Tocca per guardarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウォッチリストの作品がサーバーに追加されました。タップして視聴します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "관심 목록에 있던 작품이 서버에 추가됐어요. 탭해서 보세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra se-listen din, nå på serveren din. Trykk for å se."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z Twojej listy do obejrzenia, jest już na serwerze. Stuknij, aby obejrzeć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da sua lista para assistir, agora no seu servidor. Toque para assistir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Från din bevakningslista, nu på din server. Tryck för att titta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的待看列表中的内容已上线。点按观看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的待看清單中的作品已在伺服器上。輕點即可觀看。"
          }
        }
      }
    },
