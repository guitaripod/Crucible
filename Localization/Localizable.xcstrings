    "This Plex Home profile can't connect services. The account owner can, on their own profile." : {
      "comment" : "Shown on a restricted Home profile instead of Connect Trakt",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne Plex Home-profil kan ikke forbinde tjenester. Kontoens ejer kan gøre det på sin egen profil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Plex-Home-Profil kann keine Dienste verbinden. Das kann nur der Kontoinhaber in seinem eigenen Profil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil de Plex Home no puede conectar servicios. Solo el titular de la cuenta puede hacerlo desde su propio perfil."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tällä Plex Home -profiililla ei voi yhdistää palveluita. Tilin omistaja voi tehdä sen omassa profiilissaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce profil Plex Home ne peut pas connecter de services. Le titulaire du compte le peut, depuis son propre profil."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þessi Plex Home-prófíll getur ekki tengt þjónustur. Eigandi aðgangsins getur það á sínum eigin prófíl."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo profilo Plex Home non può collegare servizi. Il titolare dell'account può farlo dal proprio profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Plex Home プロフィールではサービスに接続できません。アカウントの所有者は、自分のプロフィールから接続できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Plex Home 프로필에서는 서비스를 연결할 수 없습니다. 계정 소유자는 자신의 프로필에서 연결할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne Plex Home-profilen kan ikke koble til tjenester. Kontoeieren kan det, i sin egen profil."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten profil Plex Home nie może łączyć usług. Może to zrobić właściciel konta na swoim profilu."
          }
        },
        "pt-BR" : {
