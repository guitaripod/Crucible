          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gildir um texta sem þjónninn teiknar inn í myndina og þá sem spilarinn teiknar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
