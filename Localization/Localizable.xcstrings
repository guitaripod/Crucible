      }
    },
    "Crucible stops sending to Trakt, tells Trakt to forget its access, and deletes what it kept about your Trakt account on this device. Your history on Trakt stays." : {
      "comment" : "Confirmation message for disconnecting Trakt",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible stopper med at sende til Trakt, beder Trakt om at glemme adgangen og sletter alt, appen har gemt om din Trakt-konto på denne enhed. Din historik på Trakt bliver bevaret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible sendet nichts mehr an Trakt, teilt Trakt mit, den Zugriff zu vergessen, und löscht auf diesem Gerät alles, was es über dein Trakt-Konto gespeichert hat. Dein Verlauf bei Trakt bleibt erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible deja de enviar datos a Trakt, le pide que olvide su acceso y borra lo que guardaba sobre tu cuenta de Trakt en este dispositivo. Tu historial en Trakt se conserva."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible lopettaa lähettämisen Traktiin, pyytää Traktia unohtamaan käyttöoikeutensa ja poistaa tältä laitteelta kaiken, mitä se säilytti Trakt-tililtäsi. Historiasi Traktissa säilyy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible arrête l'envoi vers Trakt, demande à Trakt d'oublier son accès et supprime sur cet appareil ce qu'il conservait de votre compte Trakt. Votre historique sur Trakt reste."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible hættir að senda gögn til Trakt, biður Trakt um að gleyma aðganginn og eyðir öllu sem það geymdi um Trakt-aðganginn þinn á þessu tæki. Ferillinn þinn á Trakt helst."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible smette di inviare dati a Trakt, chiede a Trakt di dimenticare il suo accesso ed elimina su questo dispositivo ciò che conservava sul tuo account Trakt. La cronologia su Trakt resta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible は Trakt への送信を停止し、Trakt にアクセス権の削除を依頼して、この端末に保存した Trakt アカウントの情報を消去します。Trakt の視聴履歴は残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible은 Trakt로 보내는 것을 멈추고, Trakt에 접근 권한을 삭제하도록 요청하며, 이 기기에 보관한 Trakt 계정 정보를 지웁니다. Trakt의 시청 기록은 그대로 남습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible slutter å sende til Trakt, ber Trakt glemme tilgangen sin og sletter det den har lagret om Trakt-kontoen din på denne enheten. Historikken din på Trakt beholdes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible przestaje wysyłać dane do Trakt, każe Trakt zapomnieć o dostępie i usuwa na tym urządzeniu wszystko, co zachował o Twoim koncie Trakt. Historia w Trakt zostaje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Crucible para de enviar dados ao Trakt, pede ao Trakt que esqueça o acesso e apaga o que guardou sobre sua conta Trakt neste dispositivo. Seu histórico no Trakt permanece."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible slutar skicka till Trakt, säger åt Trakt att glömma åtkomsten och raderar allt den har sparat om ditt Trakt-konto på den här enheten. Din historik på Trakt finns kvar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible 将停止向 Trakt 发送数据，通知 Trakt 撤销其访问权限，并删除本设备上保存的 Trakt 账户相关信息。你在 Trakt 上的历史记录会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible 將停止傳送資料至 Trakt，通知 Trakt 撤銷其存取權限，並刪除本裝置上保存的 Trakt 帳號相關資料。您在 Trakt 上的紀錄會保留。"
          }
        }
      }
    },
    "Crucible tested every connection and picked the fastest." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible testede alle forbindelser og valgte den hurtigste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible hat jede Verbindung getestet und die schnellste gewählt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible probó todas las conexiones y eligió la más rápida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible testasi jokaisen yhteyden ja valitsi nopeimman."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible a testé chaque connexion et choisi la plus rapide."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible prófaði allar tengingar og valdi þá hröðustu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible ha testato ogni connessione e ha scelto la più veloce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible はすべての接続をテストし、最も速いものを選びました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible이 모든 연결을 테스트하고 가장 빠른 연결을 골랐어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible testet hver tilkobling og valgte den raskeste."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible sprawdził każde połączenie i wybrał najszybsze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Crucible testou todas as conexões e escolheu a mais rápida."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible testade varje anslutning och valde den snabbaste."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible 测试了所有连接，并选择了最快的一个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crucible 已測試所有連線，並選擇最快的一個。"
          }
        }
      }
    },
