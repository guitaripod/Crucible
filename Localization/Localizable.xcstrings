        }
      }
    },
    "The ratings and watched marks you change" : {
      "comment" : "Data sent to Trakt: ratings and watched state",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De bedømmelser og markeringer som set, du ændrer"
          }
