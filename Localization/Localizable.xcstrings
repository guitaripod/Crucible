    "Connect the Tailscale app, come back, and Crucible looks again on its own." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbind Tailscale-appen, og kom tilbage. Crucible søger så automatisk igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde die Tailscale-App, komm zurück, und Crucible sucht von selbst erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta la app de Tailscale, vuelve y Crucible volverá a buscar por su cuenta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
