    "Purchases are turned off on this device. You can change that in Screen Time or in your Apple Account settings." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Køb er slået fra på denne enhed. Du kan ændre det under Skærmtid eller i indstillingerne for din Apple-konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käufe sind auf diesem Gerät deaktiviert. Du kannst das in der Bildschirmzeit oder in den Einstellungen deines Apple-Accounts ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las compras están desactivadas en este dispositivo. Puedes cambiarlo en Tiempo de uso o en los ajustes de tu cuenta de Apple."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostot on poistettu käytöstä tässä laitteessa. Voit muuttaa asetusta Ruutuajassa tai Apple-tilisi asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les achats sont désactivés sur cet appareil. Vous pouvez modifier cela dans Temps d’écran ou dans les réglages de votre compte Apple."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaup eru óvirk á þessu tæki. Þú getur breytt því í Skjátíma eða í stillingum Apple-aðgangsins þíns."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli acquisti sono disattivati su questo dispositivo. Puoi modificarlo in Tempo di utilizzo o nelle impostazioni del tuo Account Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスでは App 内課金がオフになっています。スクリーンタイムまたは Apple アカウントの設定で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서 구매가 꺼져 있어요. 스크린 타임 또는 Apple 계정 설정에서 바꿀 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjøp er slått av på denne enheten. Du kan endre det i Skjermtid eller i innstillingene for Apple-kontoen din."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakupy są wyłączone na tym urządzeniu. Możesz to zmienić w Czasie przed ekranem lub w ustawieniach Konta Apple."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As compras estão desativadas neste dispositivo. Você pode mudar isso no Tempo de Uso ou nos ajustes da sua Conta Apple."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Köp är avstängda på den här enheten. Du kan ändra det i Skärmtid eller i inställningarna för ditt Apple-konto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备已关闭购买功能。你可以在“屏幕使用时间”或 Apple 账户设置中更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置已關閉購買功能。您可以在「螢幕使用時間」或 Apple 帳號設定中變更此設定。"
          }
        }
      }
    },
